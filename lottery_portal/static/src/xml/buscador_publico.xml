<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.BuscadorPublico" owl="1">
        <div class="buscador-publico-widget">
            <!-- Selector de sorteo -->
            <div class="mb-3" t-if="state.sorteos.length">
                <select class="form-select buscador-publico-select"
                        t-on-change="onSorteoChange">
                    <t t-foreach="state.sorteos" t-as="s" t-key="s.id">
                        <option t-att-value="s.id"
                                t-att-selected="s.id === state.sorteoId">
                            <t t-esc="s.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <!-- Input de fecha -->
            <div class="mb-3">
                <input type="date"
                       class="form-control buscador-publico-date"
                       t-att-value="state.fecha"
                       t-on-change="buscarSalida"
                       t-att-disabled="!state.sorteoId"
                />
            </div>

            <!-- Cargando -->
            <t t-if="state.cargando">
                <div class="text-center text-muted py-2">
                    <i class="fa fa-spinner fa-spin me-2"/>Buscando...
                </div>
            </t>

            <!-- Resultados -->
            <t t-elif="state.resultados and (state.resultados.afternoon or state.resultados.evening)">
                <div class="text-center mt-2 mb-3">
                    <span class="fw-bold" style="color:#8c6ca8;font-size:20px;">
                        <t t-esc="state.resultados.dia_semana"/>
                    </span>
                </div>
                <t t-if="state.resultados.afternoon">
                    <div class="lottery-block">
                        <div class="lottery-row">
                            <div class="lottery-date-dia">
                                <i class="fa fa-sun-o sun-icon"/>
                            </div>
                            <div class="lottery-numbers">
                                <div class="box-centena-dia">
                                    <t t-esc="state.resultados.afternoon.centena"/>
                                </div>
                                <div class="box-numero-dia">
                                    <t t-esc="state.resultados.afternoon.numero"/>
                                </div>
                            </div>
                            <div class="box-extra">
                                <t t-esc="state.resultados.afternoon.bola_extra"/>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="state.resultados.evening">
                    <div class="lottery-block">
                        <div class="lottery-row">
                            <div class="lottery-date-noche">
                                <i class="fa fa-moon-o moon-icon"/>
                            </div>
                            <div class="lottery-numbers">
                                <div class="box-centena-noche">
                                    <t t-esc="state.resultados.evening.centena"/>
                                </div>
                                <div class="box-numero-noche">
                                    <t t-esc="state.resultados.evening.numero"/>
                                </div>
                            </div>
                            <div class="box-extra">
                                <t t-esc="state.resultados.evening.bola_extra"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
            <t t-elif="state.fecha and !state.cargando">
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="fa fa-info-circle me-2"/>
                    No se encontró salida para la fecha seleccionada.
                </div>
            </t>
        </div>
    </t>
</templates>
