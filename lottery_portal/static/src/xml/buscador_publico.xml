<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.BuscadorPublico" owl="1">
        <div class="buscador-publico-widget">
            <!-- Selector de sorteo -->
            <div class="mb-3" t-if="state.sorteos.length">
                <select class="form-select buscador-publico-select"
                        t-on-change="onSorteoChange">
                    <t t-foreach="state.sorteos" t-as="s" t-key="s.id">
                        <option t-att-value="s.id"
                                t-att-selected="s.id === state.sorteoId">
                            <t t-esc="s.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <!-- Input de fecha -->
            <div class="mb-3">
                <input type="date"
                       class="form-control buscador-publico-date"
                       t-att-value="state.fecha"
                       t-on-change="buscarSalida"
                       t-att-disabled="!state.sorteoId"
                />
            </div>

            <!-- Cargando -->
            <t t-if="state.cargando">
                <div class="text-center text-muted py-2">
                    <i class="fa fa-spinner fa-spin me-2"/>Buscando...
                </div>
            </t>

            <!-- Resultado de la fecha elegida -->
            <t t-elif="state.fecha and resultadosLista.length">
                <div class="bp-ultimas">
                    <t t-foreach="resultadosLista" t-as="r" t-key="r.id">
                        <t t-call="lottery_portal.BuscadorPublico.Salida"/>
                    </t>
                </div>
            </t>
            <t t-elif="state.fecha">
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="fa fa-info-circle me-2"/>
                    No se encontró salida para la fecha seleccionada.
                </div>
            </t>

            <!-- Sin fecha elegida: las últimas salidas registradas del sorteo -->
            <t t-elif="state.ultimas.length">
                <div class="bp-ultimas">
                    <div class="bp-ultimas-title">
                        <i class="fa fa-clock-o me-1"/>Últimas salidas
                    </div>
                    <t t-foreach="state.ultimas" t-as="r" t-key="r.id">
                        <t t-call="lottery_portal.BuscadorPublico.Salida"/>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <t t-name="lottery_portal.BuscadorPublico.Salida" owl="1">
        <div t-att-class="'bp-ultima ' + (r.turno === 'evening' ? 'bp-ultima--noche' : 'bp-ultima--dia')">
            <div class="bp-ultima-head">
                <i t-att-class="r.turno === 'evening' ? 'fa fa-moon-o' : 'fa fa-sun-o'"/>
                <span><t t-esc="r.dia_semana"/> <t t-esc="r.fecha"/> · <t t-esc="r.turno_label"/></span>
            </div>
            <div class="bp-ultima-balls">
                <div class="bp-ultima-ball" t-if="tiene(r.centena)">
                    <span class="bp-ball-box"><span class="bp-ball bp-ball--cen"><t t-esc="r.centena"/></span></span>
                    <small>Centena</small>
                </div>
                <div class="bp-ultima-ball">
                    <span class="bp-ball-box"><span class="bp-ball bp-ball--fijo"><t t-esc="r.numero"/></span></span>
                    <small>Fijo</small>
                </div>
                <div class="bp-ultima-ball" t-if="tiene(r.bola_extra)">
                    <span class="bp-ball-box"><span class="bp-ball bp-ball--extra"><t t-esc="r.bola_extra"/></span></span>
                    <small>Extra</small>
                </div>
            </div>
            <div class="bp-ultima-corridos" t-if="r.premio_2 or r.premio_3">
                Corridos:
                <b t-if="r.premio_2"><t t-esc="r.premio_2"/></b>
                <t t-if="r.premio_2 and r.premio_3"> · </t>
                <b t-if="r.premio_3"><t t-esc="r.premio_3"/></b>
            </div>
        </div>
    </t>
</templates>
