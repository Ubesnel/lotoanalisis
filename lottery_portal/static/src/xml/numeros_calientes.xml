<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.NumerosCalientes" owl="1">
        <div class="nc-card">

            <div class="nc-header">
                <div class="nc-header-left">
                    <i class="fa fa-fire nc-fire-icon"/>
                    <div>
                        <div class="nc-title">Calientes · Próximo Sorteo</div>
                        <div class="nc-subtitle">Basado en 7 criterios de ponderación</div>
                    </div>
                </div>
                <div class="nc-header-right">
                    <t t-if="!state.loading and nextDraw">
                        <span class="nc-next-date">
                            <i class="fa fa-calendar-o"/> <t t-esc="nextDraw"/>
                        </span>
                    </t>
                    <select class="nc-turn-select" t-on-change="onChangeTurn">
                        <option value="afternoon" t-att-selected="state.turn === 'afternoon' ? 'selected' : false">☀ Tarde</option>
                        <option value="evening"   t-att-selected="state.turn === 'evening'   ? 'selected' : false">🌙 Noche</option>
                    </select>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="nc-loading"><i class="fa fa-spinner fa-spin"/> Calculando…</div>
            </t>
            <t t-else="">

                <!-- Zona 1: Números -->
                <div class="nc-section">
                    <div class="nc-section-head">
                        <span class="nc-section-title"><i class="fa fa-sort-numeric-asc"/> Números</span>
                        <div class="nc-legend-inline">
                            <span class="nc-pip nc-pip--hot"/><span>1–10</span>
                            <span class="nc-pip nc-pip--warm"/><span>11–20</span>
                            <span class="nc-pip nc-pip--cool"/><span>21–30</span>
                        </div>
                    </div>
                    <div class="nc-numbers-grid">
                        <t t-foreach="numbers" t-as="num" t-key="num.name">
                            <div class="nc-cell">
                                <!-- Float wrapper solo para top 10 con delay escalonado -->
                                <div t-att-class="num_index &lt; 10 ? 'nc-float' : ''"
                                     t-att-style="num_index &lt; 10 ? 'animation-delay:' + (num_index * 0.22) + 's' : ''">
                                    <span t-att-class="'nc-ball ' + (num_index &lt; 10 ? 'nc-ball-hot' : num_index &lt; 20 ? 'nc-ball-warm' : 'nc-ball-cool')"
                                          t-att-title="'#' + (num_index + 1) + ' · Score: ' + num.score">
                                        <t t-esc="num.name"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Zona 2: Centenas + Bola Extra -->
                <div class="nc-cebs-row">

                    <div class="nc-cebs-col">
                        <div class="nc-section-head">
                            <span class="nc-section-title"><i class="fa fa-th"/> Centenas</span>
                            <span class="nc-section-badge">Top 4</span>
                        </div>
                        <div class="nc-cebs-grid">
                            <t t-foreach="centenas" t-as="cen" t-key="cen.name">
                                <div class="nc-ceb-item">
                                    <span class="nc-rank">#<t t-esc="cen_index + 1"/></span>
                                    <!-- Float solo para top 2 -->
                                    <div t-att-class="cen_index &lt; 2 ? 'nc-float' : ''"
                                         t-att-style="cen_index &lt; 2 ? 'animation-delay:' + (cen_index * 0.45) + 's' : ''">
                                        <span t-att-class="'nc-badge-ceb ' + (cen_index &lt; 2 ? 'nc-badge-ceb--hot' : 'nc-badge-ceb--warm')">
                                            <t t-esc="cen.name"/>
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="nc-cebs-divider"/>

                    <div class="nc-cebs-col">
                        <div class="nc-section-head">
                            <span class="nc-section-title"><i class="fa fa-star"/> Bola Extra</span>
                            <span class="nc-section-badge">Top 4</span>
                        </div>
                        <div class="nc-cebs-grid">
                            <t t-foreach="bolaExtra" t-as="be" t-key="be.name">
                                <div class="nc-ceb-item">
                                    <span class="nc-rank">#<t t-esc="be_index + 1"/></span>
                                    <div t-att-class="be_index &lt; 2 ? 'nc-float' : ''"
                                         t-att-style="be_index &lt; 2 ? 'animation-delay:' + (be_index * 0.45) + 's' : ''">
                                        <span t-att-class="'nc-badge-ceb nc-badge-ceb--extra ' + (be_index &lt; 2 ? 'nc-badge-ceb--extra-hot' : 'nc-badge-ceb--extra-warm')">
                                            <t t-esc="be.name"/>
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>

                <!-- Zona 3: Menos Calientes -->
                <div class="nc-section nc-section--cold">
                    <div class="nc-section-head">
                        <span class="nc-section-title nc-section-title--cold">
                            <i class="fa fa-snowflake-o"/> Menos Calientes
                        </span>
                        <div class="nc-legend-inline">
                            <span class="nc-pip nc-pip--cold1"/><span>1–10</span>
                            <span class="nc-pip nc-pip--cold2"/><span>11–20</span>
                            <span class="nc-pip nc-pip--cold3"/><span>21–30</span>
                        </div>
                    </div>
                    <div class="nc-numbers-grid">
                        <t t-foreach="numbersCold" t-as="num" t-key="'cold_' + num.name">
                            <div class="nc-cell">
                                <span t-att-class="'nc-ball ' + (num_index &lt; 10 ? 'nc-ball-cold1' : num_index &lt; 20 ? 'nc-ball-cold2' : 'nc-ball-cold3')"
                                      t-att-title="'#' + (num_index + 1) + ' · Score: ' + num.score">
                                    <t t-esc="num.name"/>
                                </span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Zona 4: Centenas frías + Bola Extra fría -->
                <div class="nc-cebs-row">

                    <div class="nc-cebs-col">
                        <div class="nc-section-head">
                            <span class="nc-section-title nc-section-title--cold"><i class="fa fa-th"/> Centenas frías</span>
                            <span class="nc-section-badge">Últimas 4</span>
                        </div>
                        <div class="nc-cebs-grid">
                            <t t-foreach="centenasCold" t-as="cen" t-key="'ccold_' + cen.name">
                                <div class="nc-ceb-item">
                                    <span class="nc-rank">#<t t-esc="cen_index + 1"/></span>
                                    <span t-att-class="'nc-badge-ceb nc-badge-ceb--cold ' + (cen_index &lt; 2 ? 'nc-badge-ceb--cold1' : 'nc-badge-ceb--cold2')">
                                        <t t-esc="cen.name"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="nc-cebs-divider"/>

                    <div class="nc-cebs-col">
                        <div class="nc-section-head">
                            <span class="nc-section-title nc-section-title--cold"><i class="fa fa-star"/> Bola Extra fría</span>
                            <span class="nc-section-badge">Últimas 4</span>
                        </div>
                        <div class="nc-cebs-grid">
                            <t t-foreach="bolaExtraCold" t-as="be" t-key="'becold_' + be.name">
                                <div class="nc-ceb-item">
                                    <span class="nc-rank">#<t t-esc="be_index + 1"/></span>
                                    <span t-att-class="'nc-badge-ceb nc-badge-ceb--extra nc-badge-ceb--cold ' + (be_index &lt; 2 ? 'nc-badge-ceb--cold1' : 'nc-badge-ceb--cold2')">
                                        <t t-esc="be.name"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>

            </t>
        </div>
    </t>
</templates>
