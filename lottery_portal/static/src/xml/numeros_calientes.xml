<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.NumerosCalientes" owl="1">

        <t t-if="state.loading">
            <div class="nc-loading py-4 text-center">
                <i class="fa fa-spinner fa-spin fa-2x" style="color:#8c6ca8;"/>
                <div class="mt-2" style="color:#8c6ca8;font-weight:600;">Calculando…</div>
            </div>
        </t>
        <t t-else="">

            <!-- Barra de predicción: solo el próximo turno a jugarse -->
            <div class="nc-turn-bar mb-3">
                <span class="nc-turn-label">
                    <i class="fa fa-magic"/> Predicción · Próximo sorteo
                    <t t-if="nextDraw">
                        <span class="nc-turn-date"><i class="fa fa-calendar-o"/> <t t-esc="nextDraw"/></span>
                    </t>
                </span>
                <span class="badge text-bg-light nc-turn-badge"><t t-esc="turnLabel"/></span>
            </div>

            <!-- Selector de vista por imagen -->
            <div class="row mb-3">
                <div class="col-12 col-md-5 col-lg-4">
                    <select class="form-select form-select-sm nc-imgview-select" t-on-change="setImgView">
                        <option value="">&#128248; Ver por imagen…</option>
                        <option value="hot">&#128293; Números Calientes</option>
                        <option value="cold">&#10052; Números Fríos</option>
                        <option value="remaining">&#11093; Números Restantes</option>
                    </select>
                </div>
            </div>

            <!-- Vista de imágenes por línea (col-12) -->
            <t t-if="state.imgView">
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card nc-imgview-card p-3 mb-2">
                        <div class="nc-imgview-wrap">
                            <t t-foreach="imageLines" t-as="grp" t-key="grp.line">
                                <div class="nc-imgview-col">
                                    <div class="nc-imgview-col-header">
                                        <t t-esc="grp.label"/>
                                    </div>
                                    <t t-foreach="grp.numbers" t-as="num" t-key="num.name">
                                        <div class="nc-imgview-cell">
                                            <img t-att-src="'/lottery_portal/static/src/img/numeros/' + num.name + '.png'"
                                                 t-att-alt="num.name"
                                                 class="nc-imgview-num"
                                                 t-att-title="'#' + num.rank + ' · ' + num.name"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- 3 columnas: Calientes · Restantes · Fríos -->
            <div class="row g-3">

                <!-- ── CALIENTES ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--hot">
                        <div class="nc-col-hdr nc-col-hdr--hot">
                            <i class="fa fa-fire"/>
                            <span>Calientes</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--hot"/><span>C1</span>
                                <span class="nc-pip nc-pip--warm"/><span>C2</span>
                                <span class="nc-pip nc-pip--cool"/><span>C3</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <!-- Números calientes en 3 bloques de 10 por score
                                 (C1 = los de mayor score) -->
                            <t t-foreach="hotBlocks" t-as="blk" t-key="'hotblk_' + blk.n">
                                <div class="nc-block-hdr">
                                    <span t-att-class="'nc-pip ' + blk.pip"/>
                                    Caliente <t t-esc="blk.n"/>
                                </div>
                                <div class="nc-numbers-grid">
                                    <t t-foreach="blk.numbers" t-as="num" t-key="num.name">
                                        <div class="nc-cell">
                                            <span t-att-class="'nc-ball ' + num.cls"
                                                  t-att-title="'#' + num.rank + ' · Score: ' + num.score">
                                                <t t-esc="num.name"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <!-- Centenas + Bola Extra calientes -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title"><i class="fa fa-th"/> Centenas</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenas" t-as="cen" t-key="cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + cen.cls">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <t t-if="usesFireball">
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title"><i class="fa fa-star"/> Bola Extra</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtra" t-as="be" t-key="be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + be.cls">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── RESTANTES ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--remaining">
                        <div class="nc-col-hdr nc-col-hdr--remaining">
                            <i class="fa fa-circle-o"/>
                            <span>Restantes</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--rem1"/><span>R1</span>
                                <span class="nc-pip nc-pip--rem2"/><span>R2</span>
                                <span class="nc-pip nc-pip--rem3"/><span>R3</span>
                                <span class="nc-pip nc-pip--rem4"/><span>R4</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <!-- Números restantes en 4 bloques de 10 por cercanía
                                 a Calientes (R1 = los más pegados a Calientes) -->
                            <t t-foreach="remainingBlocks" t-as="blk" t-key="'remblk_' + blk.n">
                                <div class="nc-block-hdr">
                                    <span t-att-class="'nc-pip ' + blk.pip"/>
                                    Restante <t t-esc="blk.n"/>
                                </div>
                                <div class="nc-numbers-grid">
                                    <t t-foreach="blk.numbers" t-as="num" t-key="'rem_' + num.name">
                                        <div class="nc-cell">
                                            <span t-att-class="'nc-ball ' + num.cls"
                                                  t-att-title="'#' + num.rank + ' · Score: ' + num.score">
                                                <t t-esc="num.name"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <!-- Centenas + Bola Extra restantes -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--remaining"><i class="fa fa-th"/> Centenas</span>
                                        <span class="nc-section-badge">Restantes</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenasRemaining" t-as="cen" t-key="'crem_' + cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + cen.cls">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <t t-if="usesFireball">
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--remaining"><i class="fa fa-star"/> Bola Extra</span>
                                        <span class="nc-section-badge">Restantes</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtraRemaining" t-as="be" t-key="'berem_' + be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + be.cls">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── FRÍOS ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--cold">
                        <div class="nc-col-hdr nc-col-hdr--cold">
                            <i class="fa fa-snowflake-o"/>
                            <span>Más Fríos</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--cold1"/><span>F1</span>
                                <span class="nc-pip nc-pip--cold2"/><span>F2</span>
                                <span class="nc-pip nc-pip--cold3"/><span>F3</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <!-- Números fríos en 3 bloques de 10 por score frío
                                 (F1 = los más fríos) -->
                            <t t-foreach="coldBlocks" t-as="blk" t-key="'coldblk_' + blk.n">
                                <div class="nc-block-hdr">
                                    <span t-att-class="'nc-pip ' + blk.pip"/>
                                    Frío <t t-esc="blk.n"/>
                                </div>
                                <div class="nc-numbers-grid">
                                    <t t-foreach="blk.numbers" t-as="num" t-key="'cold_' + num.name">
                                        <div class="nc-cell">
                                            <span t-att-class="'nc-ball ' + num.cls"
                                                  t-att-title="'#' + num.rank + ' · Score: ' + num.score">
                                                <t t-esc="num.name"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <!-- Centenas + Bola Extra frías -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--cold"><i class="fa fa-th"/> Centenas frías</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenasCold" t-as="cen" t-key="'ccold_' + cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb nc-badge-ceb--cold ' + cen.cls">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <t t-if="usesFireball">
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--cold"><i class="fa fa-star"/> Bola Extra fría</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtraCold" t-as="be" t-key="'becold_' + be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be.rank"/></span>
                                                <span t-att-class="'nc-badge-ceb nc-badge-ceb--extra nc-badge-ceb--cold ' + be.cls">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </div><!-- /row 3 cols -->
        </t>
    </t>
</templates>
