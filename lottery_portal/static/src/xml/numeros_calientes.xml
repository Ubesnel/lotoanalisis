<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.NumerosCalientes" owl="1">

        <t t-if="state.loading">
            <div class="nc-loading py-4 text-center">
                <i class="fa fa-spinner fa-spin fa-2x" style="color:#8c6ca8;"/>
                <div class="mt-2" style="color:#8c6ca8;font-weight:600;">Calculando…</div>
            </div>
        </t>
        <t t-else="">

            <!-- Barra de predicción / selector de turno -->
            <div class="nc-turn-bar mb-3">
                <span class="nc-turn-label">
                    <i class="fa fa-magic"/> Predicción · Próximo sorteo
                    <t t-if="nextDraw">
                        <span class="nc-turn-date"><i class="fa fa-calendar-o"/> <t t-esc="nextDraw"/></span>
                    </t>
                </span>
                <select class="form-select form-select-sm w-auto" t-on-change="onChangeTurn">
                    <option value="afternoon" t-att-selected="state.turn === 'afternoon' ? 'selected' : false">☀ Tarde</option>
                    <option value="evening"   t-att-selected="state.turn === 'evening'   ? 'selected' : false">🌙 Noche</option>
                </select>
            </div>

            <!-- 3 columnas: Calientes · Restantes · Fríos -->
            <div class="row g-3">

                <!-- ── CALIENTES ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--hot">
                        <div class="nc-col-hdr nc-col-hdr--hot">
                            <i class="fa fa-fire"/>
                            <span>Calientes</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--hot"/><span>1–10</span>
                                <span class="nc-pip nc-pip--warm"/><span>11–20</span>
                                <span class="nc-pip nc-pip--cool"/><span>21–30</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <div class="nc-numbers-grid">
                                <t t-foreach="numbers" t-as="num" t-key="num.name">
                                    <div class="nc-cell">
                                        <span t-att-class="'nc-ball ' + (num_index &lt; 10 ? 'nc-ball-hot' : num_index &lt; 20 ? 'nc-ball-warm' : 'nc-ball-cool')"
                                              t-att-title="'#' + (num_index + 1) + ' · Score: ' + num.score">
                                            <t t-esc="num.name"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                            <!-- Centenas + Bola Extra calientes -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title"><i class="fa fa-th"/> Centenas</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenas" t-as="cen" t-key="cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + (cen_index === 0 ? 'nc-badge-ceb--hot' : cen_index &lt; 3 ? 'nc-badge-ceb--warm' : 'nc-badge-ceb--cool')">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title"><i class="fa fa-star"/> Bola Extra</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtra" t-as="be" t-key="be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + (be_index === 0 ? 'nc-badge-ceb--hot' : be_index &lt; 3 ? 'nc-badge-ceb--warm' : 'nc-badge-ceb--cool')">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── RESTANTES ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--remaining">
                        <div class="nc-col-hdr nc-col-hdr--remaining">
                            <i class="fa fa-circle-o"/>
                            <span>Restantes</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--rem1"/><span>1–13</span>
                                <span class="nc-pip nc-pip--rem2"/><span>14–26</span>
                                <span class="nc-pip nc-pip--rem3"/><span>27–40</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <!-- Números restantes con 3 grupos de color por posición -->
                            <div class="nc-numbers-grid">
                                <t t-foreach="numbersRemaining" t-as="num" t-key="'rem_' + num.name">
                                    <div class="nc-cell">
                                        <span t-att-class="'nc-ball ' + (num_index &lt; 13 ? 'nc-ball-rem1' : num_index &lt; 26 ? 'nc-ball-rem2' : 'nc-ball-rem3')"
                                              t-att-title="'#' + (num_index + 1) + ' · Score: ' + num.score">
                                            <t t-esc="num.name"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                            <!-- Centenas + Bola Extra restantes -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--remaining"><i class="fa fa-th"/> Centenas</span>
                                        <span class="nc-section-badge">Restantes</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenasRemaining" t-as="cen" t-key="'crem_' + cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + (cen_index === 0 ? 'nc-badge-ceb--rem1' : 'nc-badge-ceb--rem2')">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--remaining"><i class="fa fa-star"/> Bola Extra</span>
                                        <span class="nc-section-badge">Restantes</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtraRemaining" t-as="be" t-key="'berem_' + be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb ' + (be_index === 0 ? 'nc-badge-ceb--rem1' : 'nc-badge-ceb--rem2')">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── FRÍOS ── -->
                <div class="col-12 col-md-4">
                    <div class="card shadow border-0 h-100 overflow-hidden nc-col-card nc-col-card--cold">
                        <div class="nc-col-hdr nc-col-hdr--cold">
                            <i class="fa fa-snowflake-o"/>
                            <span>Más Fríos</span>
                            <div class="nc-col-legend ms-auto">
                                <span class="nc-pip nc-pip--cold1"/><span>1–10</span>
                                <span class="nc-pip nc-pip--cold2"/><span>11–20</span>
                                <span class="nc-pip nc-pip--cold3"/><span>21–30</span>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <div class="nc-numbers-grid">
                                <t t-foreach="numbersCold" t-as="num" t-key="'cold_' + num.name">
                                    <div class="nc-cell">
                                        <span t-att-class="'nc-ball ' + (num_index &lt; 10 ? 'nc-ball-cold1' : num_index &lt; 20 ? 'nc-ball-cold2' : 'nc-ball-cold3')"
                                              t-att-title="'#' + (num_index + 1) + ' · Score: ' + num.score">
                                            <t t-esc="num.name"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                            <!-- Centenas + Bola Extra frías -->
                            <div class="nc-cebs-row mt-2">
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--cold"><i class="fa fa-th"/> Centenas frías</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="centenasCold" t-as="cen" t-key="'ccold_' + cen.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="cen_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb nc-badge-ceb--cold ' + (cen_index === 0 ? 'nc-badge-ceb--cold1' : cen_index &lt; 3 ? 'nc-badge-ceb--cold2' : 'nc-badge-ceb--cold3')">
                                                    <t t-esc="cen.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="nc-cebs-divider"/>
                                <div class="nc-cebs-col">
                                    <div class="nc-section-head">
                                        <span class="nc-section-title nc-section-title--cold"><i class="fa fa-star"/> Bola Extra fría</span>
                                        <span class="nc-section-badge">Top 4</span>
                                    </div>
                                    <div class="nc-cebs-grid">
                                        <t t-foreach="bolaExtraCold" t-as="be" t-key="'becold_' + be.name">
                                            <div class="nc-ceb-item">
                                                <span class="nc-rank">#<t t-esc="be_index + 1"/></span>
                                                <span t-att-class="'nc-badge-ceb nc-badge-ceb--extra nc-badge-ceb--cold ' + (be_index === 0 ? 'nc-badge-ceb--cold1' : be_index &lt; 3 ? 'nc-badge-ceb--cold2' : 'nc-badge-ceb--cold3')">
                                                    <t t-esc="be.name"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div><!-- /row 3 cols -->
        </t>
    </t>
</templates>
