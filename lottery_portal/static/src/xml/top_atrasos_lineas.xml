<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.TopAtrasosLineas" owl="1">
        <div class="card shadow border-0 overflow-hidden mb-4">
            <div class="card-header text-white text-center fw-bold">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fa fa-bars"/>
                    Líneas más Atrasadas
                    <i class="fa fa-arrow-right"/>
                    <select t-model="state.type_line" class="form-select form-select-sm w-auto"
                            t-on-change="onChangeTypeLineas"
                            title="Atrasos de las Líneas">
                        <option value="general">General</option>
                        <option value="afternoon">Tarde</option>
                        <option value="evening">Noche</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="stat-rank-list">
                    <t t-foreach="state.groups_lines" t-as="group_l" t-key="group_l.name">
                        <div class="stat-rank-item">
                            <span class="stat-rank-pos">#<t t-esc="group_l_index + 1"/></span>
                            <span t-att-class="'ball stat-rank-ball ' + (group_l_index &lt; 3 ? 'ball-red' : group_l_index &lt; 7 ? 'ball-blue' : 'ball-green')">
                                <t t-esc="group_l.name"/>
                            </span>
                            <span class="stat-rank-count">× <t t-esc="group_l.atraso"/></span>
                            <div class="srt-tags">
                                <span class="srt-badge srt-badge--recent" title="Último en salir">
                                    <i class="fa fa-check-circle"/>
                                    <strong><t t-esc="group_l.last_num"/></strong>
                                    <span class="srt-date"><t t-esc="group_l.last_date"/></span>
                                </span>
                                <span class="srt-badge srt-badge--delay" title="Mayor atraso del grupo">
                                    <i class="fa fa-hourglass-half"/>
                                    <strong><t t-esc="group_l.max_delay_num"/></strong>
                                    <span class="srt-date"><t t-esc="group_l.max_delay_date"/></span>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
