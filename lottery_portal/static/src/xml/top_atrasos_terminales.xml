<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.TopAtrasosTerminales" owl="1">
        <div class="card shadow border-0 overflow-hidden mb-4">
            <div class="card-header text-white text-center fw-bold">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fa fa-hashtag"/>
                    Terminales más Atrasados
                    <i class="fa fa-arrow-right"/>
                    <select t-model="state.type_terminal" class="form-select form-select-sm w-auto"
                            t-on-change="onChangeTypeTerminales"
                            title="Atrasos de los Terminales">
                        <option value="general">General</option>
                        <option value="afternoon">Tarde</option>
                        <option value="evening">Noche</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="stat-rank-list">
                    <t t-foreach="state.groups_terminales" t-as="group_t" t-key="group_t.name">
                        <div class="stat-rank-item">
                            <span class="stat-rank-pos">#<t t-esc="group_t_index + 1"/></span>
                            <span t-att-class="'ball stat-rank-ball ' + (group_t_index &lt; 3 ? 'ball-red' : group_t_index &lt; 7 ? 'ball-blue' : 'ball-green')">
                                <t t-esc="group_t.name"/>
                            </span>
                            <div class="stat-rank-info">
                                <span class="stat-rank-count">× <t t-esc="group_t.atraso"/></span>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
