<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.LotteryDashboardNumbers" owl="1">
        <section class="hero-analitico-dashboard">
            <div class="hero-content">
                <h3 class="hero-title-dashboard">
                    Analiza los números como nunca antes
                </h3>
                <p class="hero-subfrase"><i>Explora estadísticas, tendencias y comportamiento histórico en tiempo real</i></p>
            </div>
        </section>
        <div class="container mt-2 mb-2">
            <div class="row mb-2">
                <div class="col-md-3 mb-2">
                    <div class="card shadow border-0 p-3 mb-2">
                        <div class="card-header fw-bold" style="color:#8c6ca8;">🔥 Números que más salen en <t t-esc="state.kpis.month"/></div>
                        <div class="card-body p-3">
                            <div class="balls-container">
                                    <t t-foreach="state.top_numbers" t-as="num" t-key="num.name">
                                        <span t-att-class="'ball ' + getBallClass(num.rank)"
                                              t-att-title="'Cantidad de salidas históricas: ' + num.total">
                                            <t t-esc="num.name"/>
                                        </span>
                                    </t>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow border-0 p-3 overflow-hidden mb-2">
                        <div class="card-header text-white text-center fw-bold" style="background-color:#8c6ca8;">
                            Información de los números que más salen en <t t-esc="state.kpis.month"/> y no han salido este año
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                <tr>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">Número</td>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">Última salida</td>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">Turno</td>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">Día</td>
                                </tr>
                            </thead>
                                <t t-foreach="state.top_numbers_info" t-as="tni" t-key="tni.name">
                                <tr>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">
                                        <t t-esc="tni.name"/>
                                    </td>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">
                                        <t t-esc="tni.last_date"/>
                                    </td>
                                    <td class="text-center fw-bold" style="color:#8c6ca8;">
                                        <t t-if="tni.turn_day=='afternoon'">
                                            <i class="fa fa-sun-o sun-icon-general"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-moon-o moon-icon-general"/>
                                        </t>
                                    </td>
                                    <td class="text-start fw-bold" style="color:#8c6ca8;">
                                        <t t-esc="tni.week_day_label"/>
                                    </td>
                                </tr>
                            </t>
                            </table>
                            </div>
                        </div>
