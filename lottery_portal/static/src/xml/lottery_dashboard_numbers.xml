<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.LotteryDashboardNumbers" owl="1">
        <section class="hero-analitico-dashboard">
            <div class="hero-content">
                <h3 class="hero-title-dashboard">
                    Analiza los números como nunca antes
                </h3>
                <p class="hero-subfrase"><i>Explora estadísticas, tendencias y comportamiento histórico en tiempo real</i></p>
            </div>
        </section>
        <div class="container mt-2 mb-2">
            <div class="row mb-2">
                <div class="col-md-4 mb-2">
                    <div class="card shadow border-0 mb-2 overflow-hidden">
                        <div class="card-header text-white fw-bold num-card-hot">🔥 Números que más salen en <t t-esc="state.kpis.month"/></div>
                        <div class="card-body p-3">
                            <div class="balls-container">
                                    <t t-foreach="state.top_numbers" t-as="num" t-key="num.name">
                                        <div class="ball-wrap">
                                            <span t-att-class="'ball ' + getBallClass(num.rank)"
                                                  t-att-title="'Cantidad de salidas históricas: ' + num.total">
                                                <t t-esc="num.name"/>
                                            </span>
                                            <span t-if="num.salido_este_anio" class="ball-salido-badge" title="Ya salió este año">✓</span>
                                            <span t-if="!num.salido_este_anio and num.last_month_date"
                                                  t-att-class="'ball-unseen-label ' + (num.last_month_turn === 'afternoon' ? 'tarde' : 'noche')">
                                                <t t-esc="num.last_month_date"/>&#160;<t t-esc="num.last_month_week_day"/>
                                            </span>
                                        </div>
                                    </t>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow border-0 mb-2 overflow-hidden">
                        <div class="card-header text-white fw-bold" style="background:linear-gradient(135deg,#a87fc7,#c4a8e0);">
