<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.TopAtrasosParejas" owl="1">
        <div class="card shadow border-0 overflow-hidden mb-4">
            <div class="card-header text-white text-center fw-bold">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fa fa-clone"/>
                    Parejas más Atrasadas
                    <i class="fa fa-arrow-right"/>
                    <select t-model="state.type_pareja" class="form-select form-select-sm w-auto"
                            t-on-change="onChangeTypeParejas"
                            title="Atrasos de las Parejas">
                        <option value="general">General</option>
                        <option value="afternoon">Tarde</option>
                        <option value="evening">Noche</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="stat-rank-list">
                    <t t-foreach="state.groups_parejas" t-as="gp" t-key="gp.name">
                        <div class="stat-rank-item">
                            <span class="stat-rank-pos">#<t t-esc="gp_index + 1"/></span>
                            <span t-att-class="'ball stat-rank-ball ' + (gp_index &lt; 3 ? 'ball-red' : gp_index &lt; 7 ? 'ball-blue' : 'ball-green')">
                                <t t-esc="gp.name"/>
                            </span>
                            <div class="stat-rank-info">
                                <span class="stat-rank-count">× <t t-esc="gp.atraso"/></span>
                                <span class="stat-rank-date">
                                    <t t-if="gp.last_turn == 'afternoon'">
                                        <i class="fa fa-sun-o" style="color:#f59e0b;margin-right:2px;"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-moon-o" style="color:#2d5a8e;margin-right:2px;"/>
                                    </t>
                                    <i class="fa fa-calendar-o"/> <t t-esc="gp.last_date"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
