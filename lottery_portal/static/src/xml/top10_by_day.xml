<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.Top10ByDay" owl="1">
        <div class="card shadow border-0 overflow-hidden mb-4">
            <div class="card-header text-white text-center fw-bold">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fa fa-calendar"/>
                    10 Números más Atrasados
                    <i class="fa fa-arrow-right"/>
                    <select t-model="state.day" class="form-select form-select-sm w-auto" t-on-change="onChangeDay"
                            title="10 Números más Atrasados por día de la semana">
                        <option value="lu">Lunes</option>
                        <option value="ma">Martes</option>
                        <option value="mi">Miércoles</option>
                        <option value="ju">Jueves</option>
                        <option value="vi">Viernes</option>
                        <option value="sa">Sábado</option>
                        <option value="do">Domingo</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="stat-rank-list">
                    <t t-foreach="state.numbers" t-as="n" t-key="n.name">
                        <div class="stat-rank-item">
                            <span class="stat-rank-pos">#<t t-esc="n_index + 1"/></span>
                            <span t-att-class="'ball stat-rank-ball ' + (n_index &lt; 3 ? 'ball-red' : n_index &lt; 7 ? 'ball-blue' : 'ball-green')">
                                <t t-esc="n.name"/>
                            </span>
                            <div class="stat-rank-info">
                                <span class="stat-rank-count">× <t t-esc="n.total_atrasadas"/></span>
                                <span class="stat-rank-date">
                                    <t t-if="n.ultimo_turno == 'afternoon'">
                                        <i class="fa fa-sun-o" style="color:#f59e0b;margin-right:2px;"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-moon-o" style="color:#2d5a8e;margin-right:2px;"/>
                                    </t>
                                    <i class="fa fa-calendar-o"/> <t t-esc="n.ultima_fecha"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
