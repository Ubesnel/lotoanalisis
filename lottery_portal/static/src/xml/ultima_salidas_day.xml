<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lottery_portal.UltimasSalidasDay" owl="1">
        <div class="card shadow border-0 overflow-hidden mb-4">
            <div class="card-header text-white text-center fw-bold">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fa fa-history"/>
                    Últimas 8 salidas
                    <i class="fa fa-arrow-right"/>
                    <select t-model="state.day_us" class="form-select form-select-sm w-auto"
                            t-on-change="onChangeUltimasSalidas"
                            title="Últimas 8 salidas del día seleccionado">
                        <option value="lu">Lunes</option>
                        <option value="ma">Martes</option>
                        <option value="mi">Miércoles</option>
                        <option value="ju">Jueves</option>
                        <option value="vi">Viernes</option>
                        <option value="sa">Sábado</option>
                        <option value="do">Domingo</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-2">
                <t t-foreach="state.ultimas_salidas" t-as="us" t-key="us.fecha">
                    <div t-att-class="'salida-row ' + (us_index % 2 === 0 ? 'salida-row-even' : '')">
                        <div class="salida-fecha-col">
                            <span class="salida-fecha-badge">
                                <i class="fa fa-calendar-o me-1"/>
                                <t t-esc="us.fecha"/>
                            </span>
                        </div>
                        <div class="salida-turno-col salida-col-dia">
                            <span class="salida-turno-label salida-label-dia">
                                <i class="fa fa-sun-o"/> Tarde
                            </span>
                            <div class="salida-numeros">
                                <t t-if="us.numero_dia">
                                    <span class="badge-dia"><t t-esc="us.centena_dia"/></span>
                                    <span class="badge-dia"><t t-esc="us.numero_dia"/></span>
                                </t>
                                <t t-else="">
                                    <span class="salida-sin-datos">—</span>
                                </t>
                                <t t-if="us.bola_extra_dia or us.bola_extra_dia == 0">
                                    <span class="badge-dia-be"><t t-esc="us.bola_extra_dia"/></span>
                                </t>
                            </div>
                        </div>
                        <div class="salida-turno-col salida-col-noche">
                            <span class="salida-turno-label salida-label-noche">
                                <i class="fa fa-moon-o"/> Noche
                            </span>
                            <div class="salida-numeros">
                                <t t-if="us.numero_noche">
                                    <span class="badge-noche"><t t-esc="us.centena_noche"/></span>
                                    <span class="badge-noche"><t t-esc="us.numero_noche"/></span>
                                </t>
                                <t t-else="">
                                    <span class="salida-sin-datos">—</span>
                                </t>
                                <t t-if="us.bola_extra_noche or us.bola_extra_noche == 0">
                                    <span class="badge-noche-be"><t t-esc="us.bola_extra_noche"/></span>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
