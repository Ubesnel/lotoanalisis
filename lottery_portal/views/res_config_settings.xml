<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Loterías" string="Loterías" name="lottery" groups="lottery_base.group_lottery_manager">
                    <block title="Período a consultar" id="consult_period_settings">
                        <setting id="default_portal_calendar_year" string="Año">
                            <field name="portal_calendar_year"/>
                        </setting>
                        <setting id="default_portal_calendar_month" string="Mes">
                            <field name="portal_calendar_month"/>
                        </setting>
                    </block>
                    <block title="Estado de las estadísticas" id="lottery_stats_status_settings">
                        <setting string="Estado de las estadísticas"
                                 help="Las vistas de atrasos/tops se refrescan en segundo plano (cron cada 1 minuto) cuando se registran o editan salidas.">
                            <field name="lottery_stats_up_to_date" invisible="1"/>
                            <field name="lottery_stats_last_refresh" invisible="1"/>
                            <div class="content-group mt8">
                                <div invisible="not lottery_stats_up_to_date">
                                    <span class="badge text-bg-success">✓ Actualizadas</span>
                                </div>
                                <div invisible="lottery_stats_up_to_date">
                                    <span class="badge text-bg-warning">⏳ Pendiente de refresco</span>
                                </div>
                                <div class="text-muted mt4">
                                    Último refresh: <field name="lottery_stats_last_refresh" readonly="1" nolabel="1" class="oe_inline"/>
                                </div>
                                <button name="action_force_refresh_materialized_views" type="object"
                                        string="Refrescar ahora" class="btn-secondary mt8" icon="fa-refresh"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>


</odoo>
