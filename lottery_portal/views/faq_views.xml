<odoo>

    <record id="view_faq_category_tree" model="ir.ui.view">
        <field name="name">faq.category.tree</field>
        <field name="model">website.faq.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_faq_tree" model="ir.ui.view">
        <field name="name">faq.tree</field>
        <field name="model">website.faq</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" optional="hide"/>
                <field name="question"/>
                <field name="answer"/>
                <field name="category_id"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_faq_form" model="ir.ui.view">
        <field name="name">faq.form</field>
        <field name="model">website.faq</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="question"/>
                        <field name="category_id"/>
                        <field name="active"/>
                        <field name="answer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_faq" model="ir.actions.act_window">
        <field name="name">Preguntas</field>
        <field name="res_model">website.faq</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_faq_category" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">website.faq.category</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>