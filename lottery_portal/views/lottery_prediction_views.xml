<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree ──────────────────────────────────────────────────── -->
    <record id="view_lottery_prediction_tree" model="ir.ui.view">
        <field name="name">lottery.prediction.tree</field>
        <field name="model">lottery.prediction</field>
        <field name="arch" type="xml">
            <tree decoration-success="cumplida" decoration-muted="not verification_date">
                <field name="date"/>
                <field name="turn_day"/>
                <field name="hour" widget="float_time" optional="hide"/>
                <field name="sorteo_id" optional="show"/>
                <field name="temperature" optional="show"/>
                <field name="numbers_count"/>
                <field name="number_ids" widget="many2many_tags" optional="show"/>
                <field name="published" widget="boolean_toggle"/>
                <field name="cumplida" widget="boolean_toggle" readonly="1"/>
                <field name="cumplida_20" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="cumplida_10" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="cumplida_5" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="super_magico_id" optional="hide"/>
                <field name="cumplida_super_magico" widget="boolean_toggle" readonly="1" optional="hide"/>
                <field name="verification_date" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────── -->
    <record id="view_lottery_prediction_form" model="ir.ui.view">
        <field name="name">lottery.prediction.form</field>
        <field name="model">lottery.prediction</field>
        <field name="arch" type="xml">
            <form string="Predicción">
                <header>
                    <button name="action_completar_numeros" type="object"
                            string="Completar números" class="btn-primary"
                            invisible="not number_ids"
                            confirm="Se van a reemplazar las listas de 20, 10 y 5 con el resultado del cálculo. ¿Seguimos?"
                            help="Ordena los números a predecir por combinaciones, acompañantes de las tablas LotoAnálisis (general y del turno) y grupos y pintas más atrasados, y con ese orden llena las listas de 20, 10 y 5."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="turn_day"/>
                            <field name="hour" widget="float_time"/>
                            <field name="sorteo_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="temperature"/>
                            <field name="combinaciones_window"/>
                        </group>
                        <group>
                            <field name="published"/>
                            <field name="numbers_count"/>
                            <field name="numbers_count_20"/>
                            <field name="numbers_count_10"/>
                            <field name="numbers_count_5"/>
                            <field name="verification_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Números a predecir" name="numeros_principal">
                            <group>
                                <field name="cumplida" readonly="1"/>
                            </group>
                            <group string="Números a predecir">
                                <field name="number_ids" nolabel="1" colspan="2"
                                       widget="many2many_tags"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </group>
                        </page>
                        <page string="20 Números" name="numeros_20">
                            <group>
                                <field name="cumplida_20" readonly="1"/>
                            </group>
                            <group string="20 Números a predecir">
                                <field name="number_ids_20" nolabel="1" colspan="2"
                                       widget="many2many_tags"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </group>
                        </page>
                        <page string="10 Números" name="numeros_10">
                            <group>
                                <field name="cumplida_10" readonly="1"/>
                            </group>
                            <group string="10 Números a predecir">
                                <field name="number_ids_10" nolabel="1" colspan="2"
                                       widget="many2many_tags"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </group>
                        </page>
                        <page string="5 Números" name="numeros_5">
                            <group>
                                <field name="cumplida_5" readonly="1"/>
                            </group>
                            <group string="5 Números a predecir">
                                <field name="number_ids_5" nolabel="1" colspan="2"
                                       widget="many2many_tags"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </group>
                            <group string="Súper Mágico">
                                <field name="super_magico_id"
                                       domain="[('id', 'in', number_ids_5)]"
                                       options="{'no_open': True, 'no_create': True}"/>
                                <field name="cumplida_super_magico" readonly="1"/>
                            </group>
                        </page>
                        <page string="Puntajes" name="puntajes"
                              invisible="not score_html">
                            <field name="score_html" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────── -->
    <record id="view_lottery_prediction_search" model="ir.ui.view">
        <field name="name">lottery.prediction.search</field>
        <field name="model">lottery.prediction</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="number_ids"/>
                <field name="sorteo_id"/>
                <filter string="Tarde" name="pred_afternoon"
                        domain="[('turn_day', '=', 'afternoon')]"/>
                <filter string="Noche" name="pred_evening"
                        domain="[('turn_day', '=', 'evening')]"/>
                <separator/>
                <filter string="Calientes" name="pred_hot"
                        domain="[('temperature', '=', 'hot')]"/>
                <filter string="Restantes" name="pred_remaining"
                        domain="[('temperature', '=', 'remaining')]"/>
                <filter string="Fríos" name="pred_cold"
                        domain="[('temperature', '=', 'cold')]"/>
                <separator/>
                <filter string="Publicadas" name="published"
                        domain="[('published', '=', True)]"/>
                <filter string="Sin publicar" name="not_published"
                        domain="[('published', '=', False)]"/>
                <separator/>
                <filter string="Cumplidas" name="cumplidas"
                        domain="[('cumplida', '=', True)]"/>
                <filter string="No cumplidas" name="no_cumplidas"
                        domain="[('cumplida', '=', False), ('verification_date', '!=', False)]"/>
                <filter string="Sin verificar" name="sin_verificar"
                        domain="[('verification_date', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha" name="group_date"
                            context="{'group_by': 'date'}"/>
                    <filter string="Turno" name="group_turn"
                            context="{'group_by': 'turn_day'}"/>
                    <filter string="Sorteo" name="group_sorteo"
                            context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Temperatura" name="group_temperature"
                            context="{'group_by': 'temperature'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción y menú ─────────────────────────────────────────── -->
    <record id="action_lottery_prediction" model="ir.actions.act_window">
        <field name="name">Predicciones</field>
        <field name="res_model">lottery.prediction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrá tu primera predicción
            </p>
            <p>
                Elegí la fecha y el turno del próximo sorteo y agregá los
                números que predecís que van a salir.
            </p>
        </field>
    </record>

    <menuitem name="Predicciones" id="menu_predicciones_root" sequence="20"
              parent="lottery_base.home_lottery"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_prediction_item" name="Predicciones"
              parent="menu_predicciones_root"
              action="action_lottery_prediction" sequence="10"
              groups="lottery_base.group_lottery_user"/>

</odoo>
