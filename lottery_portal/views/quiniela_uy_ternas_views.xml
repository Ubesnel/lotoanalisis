<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quiniela_uy_ternas_form" model="ir.ui.view">
        <field name="name">lottery.quiniela.uy.ternas.form</field>
        <field name="model">lottery.quiniela.uy.ternas</field>
        <field name="arch" type="xml">
            <form string="Informe de ternas">
                <sheet>
                    <group>
                        <group>
                            <field name="sorteo_id"
                                   options="{'no_open': True, 'no_create': True}"
                                   placeholder="General (los 20 premios)"/>
                            <field name="turn_day" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="fecha_corte"/>
                            <field name="mes"/>
                            <field name="limite"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Más atrasadas" name="atrasadas">
                            <field name="atrasadas_html" nolabel="1"
                                   readonly="1"/>
                        </page>
                        <page string="Atrasadas del mes" name="atrasadas_mes">
                            <field name="atrasadas_mes_html" nolabel="1"
                                   readonly="1"/>
                        </page>
                        <page string="Centenas por número" name="centenas">
                            <field name="centenas_html" nolabel="1"
                                   readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_consultar" string="Consultar"
                            type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quiniela_uy_ternas" model="ir.actions.act_window">
        <field name="name">Ternas</field>
        <field name="res_model">lottery.quiniela.uy.ternas</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_quiniela_uy_ternas" name="Ternas"
              parent="menu_quiniela_uy_root"
              action="action_quiniela_uy_ternas" sequence="15"
              groups="lottery_base.group_lottery_user"/>

</odoo>
