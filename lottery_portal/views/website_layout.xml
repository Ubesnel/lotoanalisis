<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_hide_stats_menus" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <t t-if="not request.env.user.has_group('lottery_base.group_lottery_manager')">
                <style>
                    li:has(> a[href="/estadisticas-generales"]),
                    li:has(> a[href="/estadisticas"]),
                    li:has(> a[href="/estadisticas-pintas"]),
                    li:has(> a[href="/estadisticas-numeros"]) { display: none !important; }
                </style>
            </t>
        </xpath>
    </template>

    <template id="portal_website_layout_adsense_script" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <script async="async"
                src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9112696506385807"
                crossorigin="anonymous"/>
        </xpath>
    </template>

    <template id="portal_website_layout_back_to_top" inherit_id="website.layout">
        <xpath expr="//body" position="inside">
            <button id="loto-back-top" class="loto-back-top" title="Volver al inicio">
                <i class="fa fa-arrow-up"/>
            </button>
            <script>//<![CDATA[
                document.getElementById('loto-back-top').addEventListener('click', function () {
                    var wrap = document.getElementById('wrapwrap');
                    if (wrap) { wrap.scrollTo({ top: 0, behavior: 'smooth' }); }
                });
            //]]></script>
        </xpath>
    </template>
</odoo>
