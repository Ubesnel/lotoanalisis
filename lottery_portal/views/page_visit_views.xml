<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista lista ── -->
    <record id="view_lottery_page_visit_list" model="ir.ui.view">
        <field name="name">lottery.page.visit.tree</field>
        <field name="model">lottery.page.visit</field>
        <field name="arch" type="xml">
            <tree string="Visitas" default_order="visit_date desc" decoration-info="is_authenticated" create="false">
                <field name="visit_date" string="Fecha"/>
                <field name="url" string="Página"/>
                <field name="ip" string="IP"/>
                <field name="country_name" string="País" optional="show"/>
                <field name="country_code" string="Código" optional="hide"/>
                <field name="is_authenticated" string="Autenticado" widget="boolean_toggle"/>
                <field name="user_id" string="Usuario" optional="show"/>
                <field name="language" string="Idioma" optional="hide"/>
                <field name="referrer" string="Referrer" optional="hide"/>
                <field name="user_agent" string="User Agent" optional="hide"/>
                <field name="session_id" string="Sesión" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ── Vista formulario ── -->
    <record id="view_lottery_page_visit_form" model="ir.ui.view">
        <field name="name">lottery.page.visit.form</field>
        <field name="model">lottery.page.visit</field>
        <field name="arch" type="xml">
            <form string="Visita" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Página">
                            <field name="visit_date" string="Fecha y hora"/>
                            <field name="url" string="URL"/>
                            <field name="method" string="Método"/>
                            <field name="referrer" string="Referrer"/>
                        </group>
                        <group string="Visitante">
                            <field name="ip" string="IP"/>
                            <field name="country_name" string="País"/>
                            <field name="country_code" string="Código país"/>
                            <field name="language" string="Idioma"/>
                            <field name="user_agent" string="User Agent"/>
                            <field name="is_authenticated" string="Autenticado"/>
                            <field name="user_id" string="Usuario"/>
                            <field name="session_id" string="Sesión"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Vista gráfico (por URL) ── -->
    <record id="view_lottery_page_visit_graph" model="ir.ui.view">
        <field name="name">lottery.page.visit.graph</field>
        <field name="model">lottery.page.visit</field>
        <field name="arch" type="xml">
            <graph string="Visitas por página" type="bar">
                <field name="url" type="row"/>
                <field name="visit_date" type="col" interval="day"/>
            </graph>
        </field>
    </record>

    <!-- ── Vista pivot ── -->
    <record id="view_lottery_page_visit_pivot" model="ir.ui.view">
        <field name="name">lottery.page.visit.pivot</field>
        <field name="model">lottery.page.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visitas">
                <field name="url" type="row"/>
                <field name="visit_date" type="col" interval="day"/>
            </pivot>
        </field>
    </record>

    <!-- ── Búsqueda ── -->
    <record id="view_lottery_page_visit_search" model="ir.ui.view">
        <field name="name">lottery.page.visit.search</field>
        <field name="model">lottery.page.visit</field>
        <field name="arch" type="xml">
            <search string="Buscar visitas">
                <field name="url" string="URL"/>
                <field name="ip" string="IP"/>
                <field name="user_id" string="Usuario"/>
                <field name="country_name" string="País"/>
                <separator/>
                <filter name="authenticated" string="Autenticados" domain="[('is_authenticated','=',True)]"/>
                <filter name="anonymous" string="Anónimos" domain="[('is_authenticated','=',False)]"/>
                <separator/>
                <filter name="today" string="Hoy"
                        domain="[('visit_date','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="this_week" string="Esta semana"
                        domain="[('visit_date','&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_url" string="Página" context="{'group_by': 'url'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'visit_date:day'}"/>
                    <filter name="group_country" string="País" context="{'group_by': 'country_name'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción ── -->
    <record id="action_lottery_page_visit" model="ir.actions.act_window">
        <field name="name">Visitas al portal</field>
        <field name="res_model">lottery.page.visit</field>
        <field name="view_mode">tree,graph,pivot,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- ── Menú (bajo Sitio Web) ── -->
    <menuitem id="menu_lottery_page_visit"
              name="Visitas al portal"
              parent="menu_faq_root"
              action="action_lottery_page_visit"
              groups="lottery_base.group_lottery_manager"
              sequence="50"/>

</odoo>
