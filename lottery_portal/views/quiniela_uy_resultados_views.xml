<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quiniela_uy_resultados_form" model="ir.ui.view">
        <field name="name">lottery.quiniela.uy.resultados.form</field>
        <field name="model">lottery.quiniela.uy.resultados</field>
        <field name="arch" type="xml">
            <form string="Resultados Quiniela Uruguay">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="turn_day" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <field name="result_html" nolabel="1" colspan="2"/>
                </sheet>
                <footer>
                    <button name="action_consultar" string="Consultar"
                            type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quiniela_uy_resultados" model="ir.actions.act_window">
        <field name="name">Resultados</field>
        <field name="res_model">lottery.quiniela.uy.resultados</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Menú nuevo: Informes Quiniela Uruguay ─────────────────────── -->
    <menuitem id="menu_quiniela_uy_root" name="Informes Quiniela Uruguay"
              parent="lottery_base.home_lottery" sequence="30"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_quiniela_uy_resultados" name="Resultados"
              parent="menu_quiniela_uy_root"
              action="action_quiniela_uy_resultados" sequence="10"
              groups="lottery_base.group_lottery_user"/>

</odoo>
