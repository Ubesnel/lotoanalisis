<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree ──────────────────────────────────────────────────── -->
    <record id="view_lottery_curiosity_tree" model="ir.ui.view">
        <field name="name">lottery.curiosity.tree</field>
        <field name="model">lottery.curiosity</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not published"
                  decoration-success="resultado == 'cumplida'"
                  decoration-danger="resultado == 'no_cumplida'">
                <field name="date"/>
                <field name="hour" widget="float_time" optional="show"/>
                <field name="plazo_hasta" optional="show"/>
                <field name="sorteo_id" optional="show"/>
                <field name="text"/>
                <field name="resultado" widget="badge" optional="show"
                       decoration-success="resultado == 'cumplida'"
                       decoration-danger="resultado == 'no_cumplida'"/>
                <field name="published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────── -->
    <record id="view_lottery_curiosity_form" model="ir.ui.view">
        <field name="name">lottery.curiosity.form</field>
        <field name="model">lottery.curiosity</field>
        <field name="arch" type="xml">
            <form string="Curiosidad">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="hour" widget="float_time"/>
                            <field name="plazo_hasta"/>
                            <field name="sorteo_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="published"/>
                            <field name="resultado" widget="radio" options="{'horizontal': true}"/>
                            <field name="cumplida_date" invisible="resultado != 'cumplida'"/>
                        </group>
                    </group>
                    <group string="Por qué se cumplió o no" invisible="resultado == 'sin_definir'">
                        <field name="resultado_detalle" nolabel="1" colspan="2"
                               placeholder="Se cumplió porque salió el 56 dentro de las fechas dichas, el 12/11 en la Noche."/>
                    </group>
                    <group string="Por qué (inglés) — opcional" invisible="resultado == 'sin_definir'">
                        <field name="resultado_detalle_en" nolabel="1" colspan="2"
                               placeholder="It came true because 56 was drawn within the stated dates, on 11/12 at Night."/>
                    </group>
                    <group string="Noticia (español)">
                        <field name="text" nolabel="1" colspan="2"
                               placeholder="Escribí la curiosidad o información a mostrar en la app…"/>
                    </group>
                    <group string="Noticia (inglés) — opcional">
                        <field name="text_en" nolabel="1" colspan="2"
                               placeholder="English translation (optional). If empty, Spanish is shown to English users too."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────── -->
    <record id="view_lottery_curiosity_search" model="ir.ui.view">
        <field name="name">lottery.curiosity.search</field>
        <field name="model">lottery.curiosity</field>
        <field name="arch" type="xml">
            <search>
                <field name="text"/>
                <field name="date"/>
                <field name="sorteo_id"/>
                <filter string="Hoy" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Publicadas" name="published"
                        domain="[('published', '=', True)]"/>
                <filter string="Sin publicar" name="not_published"
                        domain="[('published', '=', False)]"/>
                <separator/>
                <filter string="Cumplidas" name="cumplidas"
                        domain="[('resultado', '=', 'cumplida')]"/>
                <filter string="No cumplidas" name="no_cumplidas"
                        domain="[('resultado', '=', 'no_cumplida')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha" name="group_date"
                            context="{'group_by': 'date'}"/>
                    <filter string="Sorteo" name="group_sorteo"
                            context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Resultado" name="group_resultado"
                            context="{'group_by': 'resultado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción y menú ─────────────────────────────────────────── -->
    <record id="action_lottery_curiosity" model="ir.actions.act_window">
        <field name="name">Curiosidades</field>
        <field name="res_model">lottery.curiosity</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrá la primera curiosidad
            </p>
            <p>
                Escribí curiosidades o informaciones por sorteo y publicalas
                para que aparezcan en la app en "LotoAnálisis informa".
            </p>
        </field>
    </record>

    <menuitem id="menu_lottery_curiosity" name="Curiosidades"
              parent="lottery_base.menu_contenido_root"
              action="action_lottery_curiosity" sequence="10"
              groups="lottery_base.group_lottery_user"/>

</odoo>
