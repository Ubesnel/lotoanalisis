<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage_lottery_widget" inherit_id="website.homepage" name="Inicio">
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="hero-analitico">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Analiza. <span>Comprende.</span> Decide mejor
                    </h1>
                    <p class="hero-subfrase">
                        <i>
                            Histórico de números ganadores de Pick 3 Florida (29 de abril de 1988 – Actualidad)
                        </i>
                    </p>
                    <h3 class="hero-title">
                        Estadísticas inteligentes en un solo lugar
                    </h3>
                </div>
            </section>
            <div class="container mt-2 mb-2">
                <div class="row mb-2">
                    <div class="col-md-3 mb-2">
                        <div class="card shadow border-0 p-3 mb-4">
                            <t t-if="lottery_data.get('afternoon')">
                                <div class="lottery-block">
                                    <div class="lottery-date-dia">
                                        <i class="fa fa-sun-o sun-icon"/>
                                        <t t-esc="lottery_data['afternoon']['date']"/>
                                    </div>
                                    <div class="lottery-row">
                                        <!-- Izquierda -->
                                        <div class="lottery-numbers">
                                            <!-- Centena -->
                                            <div class="box-centena-dia">
                                                <t t-esc="lottery_data['afternoon']['centena']"/>
                                            </div>

                                            <!-- Número verde -->
                                            <div class="box-numero-dia">
                                                <t t-esc="lottery_data['afternoon']['numero']"/>
                                            </div>

                                        </div>

                                        <!-- Bola Extra -->
                                        <div class="box-extra">
                                            <t t-esc="lottery_data['afternoon']['extra']"/>
                                        </div>

                                    </div>
                                </div>
                            </t>
                            <t t-if="lottery_data.get('evening')">
                                <div class="lottery-block">

                                    <div class="lottery-date-noche">
                                        <i class="fa fa-moon-o moon-icon"/>
                                        <t t-esc="lottery_data['evening']['date']"/>
                                    </div>

                                    <div class="lottery-row">

                                        <div class="lottery-numbers">


                                            <div class="box-centena-noche">
                                                <t t-esc="lottery_data['evening']['centena']"/>
                                            </div>


                                            <div class="box-numero-noche">
                                                <t t-esc="lottery_data['evening']['numero']"/>
                                            </div>

                                        </div>

                                        <div class="box-extra">
                                            <t t-esc="lottery_data['evening']['extra']"/>
                                        </div>

                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="card shadow border-0 p-3 mb-4">
                            <div class="card-header text-white fw-bold" style="background-color:#8c6ca8;">
                                <i class="fa fa-search me-2"/>
                                Buscar salida histórica
                            </div>
                            <div class="card-body p-3">
                                <owl-component name="lottery_portal.SalidasBuscador"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <owl-component name="lottery_portal.TopAtrasos"/>
                    </div>
                    <div class="col-md-3 mb-2">
                        <owl-component name="lottery_portal.Top10ByDay"/>
                    </div>
                    <div class="col-md-3 mb-2">
                        <owl-component name="lottery_portal.UltimasSalidasDay"/>
                    </div>
                </div>
            </div>
            <div class="container mt-2 mb-5">
                <div class="row mb-2">
                    <div class="col-md-2 mb-2">
                        <owl-component name="lottery_portal.TopAtrasosLineas"/>
                    </div>
                    <div class="col-md-2 mb-2">
                        <owl-component name="lottery_portal.TopAtrasosTerminales"/>
                    </div>
                    <div class="col-md-2 mb-2">
                        <owl-component name="lottery_portal.TopAtrasosParejas"/>
                    </div>
                    <div class="col-md-3 mb-2">
                        <owl-component name="lottery_portal.Top5CentenasAtrasadas"/>
                    </div>
                    <div class="col-md-3 mb-2">
                        <owl-component name="lottery_portal.Top5BolaExtraAtrasadas"/>
                    </div>
                </div>
            </div>
            <section>
                <div class="quick-container">
                    <div class="quick-card contacto-card">
                        <h3>¿Tienes dudas?</h3>
                        <p>
                            Estamos disponibles para ayudarte con cualquier consulta.
                        </p>
                        <a href="/contactus" class="btn-contacto">
                            Contáctanos
                        </a>
                    </div>
                    <div class="quick-card">
                        <h3>Consultas avanzadas Grupos</h3>
                        <p>
                            Explora frecuencias, atrasos y tendencias históricas detalladas de Grupos.
                        </p>
                        <a href="/estadisticas" class="quick-link">
                            Ir a Grupos →
                        </a>
                    </div>
                    <div class="quick-card">
                        <h3>Consultas avanzadas Números</h3>
                        <p>
                            Explora frecuencias, atrasos y tendencias históricas detalladas de los Números.
                        </p>
                        <a href="/estadisticas-numeros" class="quick-link">
                            Ir a Números →
                        </a>
                    </div>
                    <div class="quick-card contacto-card">
                        <h3>Preguntas y respuestas</h3>
                        <p>
                            Podes encontrar respuestas a muchas preguntas relacionadas con las estadísticas.
                        </p>
                        <a href="/faq" class="btn-contacto">
                            Revisar →
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>

