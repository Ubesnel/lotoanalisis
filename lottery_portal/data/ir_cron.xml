<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_generate_monthly_analysis_article" model="ir.cron">
            <field name="name">Generar Artículo de Análisis Mensual</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_monthly_analysis()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_grupos_atrasados" model="ir.cron">
            <field name="name">Generar Artículos — Grupos más atrasados</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_grupos_atrasados()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_pintas_atrasadas" model="ir.cron">
            <field name="name">Generar Artículos — Pintas más atrasadas</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_pintas_atrasadas()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_numeros_atrasados" model="ir.cron">
            <field name="name">Generar Artículo — Números más atrasados (General/Tarde/Noche)</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_numeros_atrasados()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_numeros_dia_semana" model="ir.cron">
            <field name="name">Generar Artículo diario — Números más atrasados por día</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_numeros_dia_semana()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_secuencias_lineas" model="ir.cron">
            <field name="name">Generar Artículo diario — Secuencias de Líneas</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_secuencias_lineas()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_secuencias_terminales" model="ir.cron">
            <field name="name">Generar Artículo diario — Secuencias de Terminales</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_secuencias_terminales()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_fin_de_semana_grupos" model="ir.cron">
            <field name="name">Generar Artículo semanal — Grupos Sábado+Domingo</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_fin_de_semana_grupos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_generate_numeros_salidores_dia" model="ir.cron">
            <field name="name">Generar Artículo diario — Números más salidores por día</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_numeros_salidores_dia()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_generate_grupos_dia_semana" model="ir.cron">
            <field name="name">Generar Artículo diario — Líneas y Terminales más atrasadas por día</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_grupos_dia_semana()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_refresh_materialized_views" model="ir.cron">
            <field name="name">Refrescar vistas materializadas (si hay cambios)</field>
            <field name="model_id" ref="lottery_base.model_lottery_output"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_materialized_views()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="priority">1</field>
            <field name="active" eval="True"/>
        </record>

    </data>

    <!-- noupdate="1": el upgrade no sobreescribe cambios manuales en la BD -->
    <data noupdate="1">

        <!-- Artículo combinado Tarde: calientes + fríos del sorteo de la tarde -->
        <record id="cron_generate_calientes" model="ir.cron">
            <field name="name">Generar Artículo diario — Calientes y Fríos Tarde</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_calientes_frios_tarde()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="nextcall">2026-05-25 12:00:00</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Artículo combinado Noche: calientes + fríos del sorteo de la noche (después de las 15:00 hora local) -->
        <record id="cron_generate_frios" model="ir.cron">
            <field name="name">Generar Artículo diario — Calientes y Fríos Noche</field>
            <field name="model_id" ref="lottery_portal.model_news_article"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_calientes_frios_noche()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="nextcall">2026-05-25 20:00:00</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
