<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_video_config_form" model="ir.ui.view">
        <field name="name">lottery.video.config.form</field>
        <field name="model">lottery.video.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Video">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group string="Personajes">
                        <group>
                            <field name="valeria_image" widget="image"
                                   options="{'size': [200, 300]}"
                                   string="Valeria"/>
                            <field name="valeria_image_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="mateo_image" widget="image"
                                   options="{'size': [200, 300]}"
                                   string="Mateo"/>
                            <field name="mateo_image_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Parámetros del Video">
                        <group>
                            <field name="video_width"/>
                            <field name="video_height"/>
                            <field name="video_fps"/>
                        </group>
                        <group>
                            <field name="bg_color_hex" string="Color de Fondo (#hex)"/>
                            <field name="accent_color_hex" string="Color Acento (#hex)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_video_config" model="ir.actions.act_window">
        <field name="name">Configuración de Personajes</field>
        <field name="res_model">lottery.video.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
