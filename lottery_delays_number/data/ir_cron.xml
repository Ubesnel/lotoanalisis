            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="priority">3</field>
            <field name="active" eval="False"/>
        </record>

        <record id="actualizar_atrasos_turnos_numeros" model="ir.cron">
            <field name="name">Actualizar atrasos por turno de Números</field>
            <field name="model_id" ref="model_lottery_number"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_atrasos_turno()</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="priority">3</field>
            <field name="active" eval="False"/>
        </record>

