<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="actualizar_salidas_atrasadas_numeros" model="ir.cron">
            <field name="name">Actualizar salidas atrasadas de Números</field>
            <field name="model_id" ref="model_lottery_number"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_atrasos_full()</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="priority">3</field>
            <field name="active" eval="False"/>
        </record>

        <record id="actualizar_totales_salidas_numeros" model="ir.cron">
