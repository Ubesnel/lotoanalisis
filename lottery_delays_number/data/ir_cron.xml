            <field name="name">Actualizar atrasos por días de la semana de Números</field>
            <field name="model_id" ref="model_lottery_number"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_atrasos_por_dia_semana()</field>
            <field name='interval_number'>1</field>
