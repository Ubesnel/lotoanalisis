<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_number_form_inherit" model="ir.ui.view">
        <field name="name">lottery.number.form.inherit.stat</field>
        <field name="model">lottery.number</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_number_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page string="Estadísticas por sorteo">
                        <field name="stat_ids">
                            <tree create="0" edit="0" delete="0" default_order="sorteo_id">
                                <field name="sorteo_id" optional="show"/>
                                <field name="total_salidas"/>
                                <field name="total_atrasadas"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <record id="view_lottery_number_stat_tree" model="ir.ui.view">
        <field name="name">view.lottery.number.stat.tree</field>
        <field name="model">lottery.number.stat</field>
        <field name="arch" type="xml">
            <tree string="Estadísticas por sorteo" create="0" edit="0" delete="0" default_order="sorteo_id, number_name">
                <field name="sorteo_id" optional="show"/>
                <field name="number_name"/>
                <field name="total_salidas" optional="hide"/>
                <field name="total_atrasadas"/>
                <field name="salidas_atrasadas_lunes" optional="hide"/>
                <field name="salidas_atrasadas_martes" optional="hide"/>
                <field name="salidas_atrasadas_miercoles" optional="hide"/>
                <field name="salidas_atrasadas_jueves" optional="hide"/>
                <field name="salidas_atrasadas_viernes" optional="hide"/>
                <field name="salidas_atrasadas_sabado" optional="hide"/>
                <field name="salidas_atrasadas_domingo" optional="hide"/>
                <field name="cant_salidas_enero" optional="hide"/>
                <field name="cant_salidas_febrero" optional="hide"/>
                <field name="cant_salidas_marzo" optional="hide"/>
                <field name="cant_salidas_abril" optional="hide"/>
                <field name="cant_salidas_mayo" optional="hide"/>
                <field name="cant_salidas_junio" optional="hide"/>
                <field name="cant_salidas_julio" optional="hide"/>
                <field name="cant_salidas_agosto" optional="hide"/>
                <field name="cant_salidas_septiembre" optional="hide"/>
                <field name="cant_salidas_octubre" optional="hide"/>
                <field name="cant_salidas_noviembre" optional="hide"/>
                <field name="cant_salidas_diciembre" optional="hide"/>
                <field name="total_semana_1" optional="hide"/>
                <field name="total_semana_2" optional="hide"/>
                <field name="total_semana_3" optional="hide"/>
                <field name="total_semana_4" optional="hide"/>
                <field name="total_semana_5" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_number_stat_form" model="ir.ui.view">
        <field name="name">lottery.number.stat.form</field>
        <field name="model">lottery.number.stat</field>
        <field name="arch" type="xml">
            <form string="Estadísticas del número" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="number_id"/>
                            <field name="sorteo_id"/>
                        </group>
                        <group>
                            <field name="total_salidas"/>
                            <field name="total_atrasadas"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Por turno" name="por_turno">
                            <field name="turno_stat_ids">
                                <tree>
                                    <field name="turno_id"/>
                                    <field name="total_salidas"/>
                                    <field name="total_atrasadas"/>
                                    <field name="ultima_fecha"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Por día de la semana" name="por_dia">
                            <group>
                                <group string="Salidas">
                                    <field name="total_lunes"/>
                                    <field name="total_martes"/>
                                    <field name="total_miercoles"/>
                                    <field name="total_jueves"/>
                                    <field name="total_viernes"/>
                                    <field name="total_sabado"/>
                                    <field name="total_domingo"/>
                                </group>
                                <group string="Atraso (semanas)">
                                    <field name="salidas_atrasadas_lunes"/>
                                    <field name="salidas_atrasadas_martes"/>
                                    <field name="salidas_atrasadas_miercoles"/>
                                    <field name="salidas_atrasadas_jueves"/>
                                    <field name="salidas_atrasadas_viernes"/>
                                    <field name="salidas_atrasadas_sabado"/>
                                    <field name="salidas_atrasadas_domingo"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lottery_number_stat_search" model="ir.ui.view">
        <field name="name">lottery.number.stat.search</field>
        <field name="model">lottery.number.stat</field>
        <field name="arch" type="xml">
            <search string="Estadísticas de números">
                <field name="number_id"/>
                <field name="number_name"/>
                <field name="sorteo_id"/>
                <filter string="Con salidas" name="con_salidas" domain="[('total_salidas', '&gt;', 0)]"/>
                <filter string="Sin salidas (nunca salió)" name="sin_salidas" domain="[('total_salidas', '=', 0)]"/>
                <separator/>
                <filter string="Florida" name="filter_sorteo_florida" domain="[('sorteo_id.code', '=', 'florida')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sorteo" name="group_sorteo_id" domain="[]" context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Número" name="group_number" domain="[]" context="{'group_by': 'number_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lottery_number_stat" model="ir.actions.act_window">
        <field name="name">Atrasos de números</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.number.stat</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_sorteo_florida': 1}</field>
        <field name="search_view_id" ref="view_lottery_number_stat_search"/>
    </record>

    <!-- Atrasos por turno: una fila por número, sorteo y turno. -->
    <record id="view_lottery_number_stat_turno_tree" model="ir.ui.view">
        <field name="name">view.lottery.number.stat.turno.tree</field>
        <field name="model">lottery.number.stat.turno</field>
        <field name="arch" type="xml">
            <tree string="Atrasos por turno" create="0" edit="0" delete="0">
                <field name="sorteo_id" optional="show"/>
                <field name="turno_id"/>
                <field name="number_name"/>
                <field name="total_salidas"/>
                <field name="total_atrasadas"/>
                <field name="ultima_fecha"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_number_stat_turno_search" model="ir.ui.view">
        <field name="name">lottery.number.stat.turno.search</field>
        <field name="model">lottery.number.stat.turno</field>
        <field name="arch" type="xml">
            <search string="Atrasos por turno">
                <field name="number_name"/>
                <field name="sorteo_id"/>
                <field name="turno_id"/>
                <filter string="Florida" name="filter_sorteo_florida" domain="[('sorteo_id.code', '=', 'florida')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sorteo" name="group_sorteo_id" domain="[]" context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Turno" name="group_turno_id" domain="[]" context="{'group_by': 'turno_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lottery_number_stat_turno" model="ir.actions.act_window">
        <field name="name">Atrasos por turno</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.number.stat.turno</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_filter_sorteo_florida': 1, 'search_default_group_turno_id': 1}</field>
        <field name="search_view_id" ref="view_lottery_number_stat_turno_search"/>
    </record>
</odoo>
