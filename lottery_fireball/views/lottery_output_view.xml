<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_output_fireball_all_tree" model="ir.ui.view">
        <field name="name">lottery.output.tree</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_all_tree"/>
        <field name="arch" type="xml">
            <field name="complete_number" position="after">
                <field name="sorteo_uses_fireball" column_invisible="1"/>
                <field name="fireball_id" invisible="not sorteo_uses_fireball"/>
            </field>
        </field>
    </record>

    <record id="view_lottery_output_fireball_tree" model="ir.ui.view">
        <field name="name">lottery.output.tree</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_tree"/>
        <field name="arch" type="xml">
            <field name="complete_number" position="after">
                <field name="sorteo_uses_fireball" column_invisible="1"/>
                <field name="fireball_id" invisible="not sorteo_uses_fireball"/>
            </field>
        </field>
    </record>

    <record id="view_lottery_output_fireball_form" model="ir.ui.view">
        <field name="name">lottery.output.form</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_form"/>
        <field name="arch" type="xml">
            <field name="complete_number" position="after">
                <field name="sorteo_uses_fireball" invisible="1"/>
                <field name="fireball_id" options="{'no_open': True, 'no_create': True}"
                       invisible="not sorteo_uses_fireball"/>
            </field>
        </field>
    </record>

    <record id="view_lottery_output_kanban_afternoon_inherit" model="ir.ui.view">
        <field name="name">lottery.output.kanban.afternoon.inherit</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_kanban_afternoon"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="fireball_id"/>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']/div" position="inside">
                <span t-if="record.fireball_id.value"
                      class="badge bg-danger text-white position-absolute bottom-0 end-0 m-2">
                    <field name="fireball_id"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="view_lottery_output_kanban_evening_inherit" model="ir.ui.view">
        <field name="name">lottery.output.kanban.evening.inherit</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_kanban_evening"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="fireball_id"/>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']/div" position="inside">
                <span t-if="record.fireball_id.value"
                      class="badge bg-danger text-white position-absolute bottom-0 end-0 m-2">
                    <field name="fireball_id"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
