<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_lottery_agenda" model="ir.ui.view">
        <field name="name">res.config.settings.view.lottery.agenda</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='lottery_portal']" position="inside">
                <block title="Agenda de loterías" id="lottery_agenda_settings">
                    <setting string="Usuarios de la agenda"
                             help="Quiénes reciben los eventos de publicar cada sorteo. Vacío = los usuarios del grupo Administrador de Lotería.">
                        <field name="agenda_user_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Aviso antes de la hora"
                             help="Minutos antes de la hora de publicar a los que suena el aviso en Odoo.">
                        <field name="agenda_aviso_min"/> minutos antes
                    </setting>
                    <setting string="Aviso también a la hora"
                             help="Además del aviso anticipado, suena otro justo a la hora de publicar.">
                        <field name="agenda_aviso_hora"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
