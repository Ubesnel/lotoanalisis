<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_sorteo_form_agenda" model="ir.ui.view">
        <field name="name">lottery.sorteo.form.agenda</field>
        <field name="model">lottery.sorteo</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_sorteo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_pick3']" position="after">
                <field name="agenda_enabled"/>
            </xpath>
            <xpath expr="//field[@name='hora_ampm']" position="after">
                <field name="pub_h"/>
                <field name="pub_min"/>
                <field name="pub_ampm" readonly="not pub_h"/>
            </xpath>
        </field>
    </record>
</odoo>
