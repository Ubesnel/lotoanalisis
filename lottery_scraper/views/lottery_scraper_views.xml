<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_scraper_form" model="ir.ui.view">
        <field name="name">lottery.scraper.form</field>
        <field name="model">lottery.scraper</field>
        <field name="arch" type="xml">
            <form string="Importador Pick 3 · Florida">
                <header>
                    <button name="action_import_now"
                            string="Importar ahora"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"/>
                </header>
                <sheet>
                    <group string="Ventanas horarias (hora ET)">
                        <group string="TARDE ☀ (sorteo ~1:30 PM ET)">
                            <field name="afternoon_start"
                                   widget="float_time"
                                   string="Inicio"/>
                            <field name="afternoon_end"
                                   widget="float_time"
                                   string="Fin"/>
                        </group>
                        <group string="NOCHE 🌙 (sorteo ~9:45 PM ET)">
                            <field name="evening_start"
                                   widget="float_time"
                                   string="Inicio"/>
                            <field name="evening_end"
                                   widget="float_time"
                                   string="Fin"/>
                        </group>
                    </group>
                    <group string="Zona horaria">
                        <field name="et_offset"
                               string="Offset UTC→ET (horas)"
                               help="-4 en verano EDT (mar-nov) · -5 en invierno EST (nov-mar)"/>
                    </group>
                    <group string="Importación manual por rango">
                        <group>
                            <field name="date_from" string="Fecha desde"/>
                            <field name="date_to"   string="Fecha hasta"/>
                        </group>
                        <group>
                            <field name="page_load_timeout" string="Timeout (seg)"/>
                            <field name="api_url"
                                   string="URL de API"
                                   placeholder="Vacío = API oficial Florida Lottery"/>
                        </group>
                    </group>
                    <group string="Estado">
                        <field name="last_run" string="Última ejecución"/>
                    </group>
                    <field name="last_result" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_scraper" model="ir.actions.act_window">
        <field name="name">Importador Pick 3</field>
        <field name="res_model">lottery.scraper</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_lottery_scraper_root"
              name="Importadores"
              parent="lottery_base.menu_configuracion_root"
              sequence="10"
              groups="lottery_base.group_lottery_manager"/>

    <menuitem id="menu_lottery_scraper"
              name="Pick 3 · Florida"
              parent="menu_lottery_scraper_root"
              action="action_lottery_scraper"
              sequence="10"/>

    <record id="view_lottery_scraper_quiniela_uy_form" model="ir.ui.view">
        <field name="name">lottery.scraper.quiniela.uy.form</field>
        <field name="model">lottery.scraper.quiniela.uy</field>
        <field name="arch" type="xml">
            <form string="Importador Quiniela Uruguay">
                <header>
                    <button name="action_import_now"
                            string="Importar ahora"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"/>
                </header>
                <sheet>
                    <group string="Turnos">
                        <field name="import_turns" string="Turnos a importar"/>
                    </group>
                    <group string="Ventanas horarias (hora Uruguay)">
                        <group string="VESPERTINA ☀ (sorteo ~15:00)">
                            <field name="vespertina_start" widget="float_time" string="Inicio"/>
                            <field name="vespertina_end" widget="float_time" string="Fin"/>
                        </group>
                        <group string="NOCTURNA 🌙 (sorteo ~21:00)">
                            <field name="nocturna_start" widget="float_time" string="Inicio"/>
                            <field name="nocturna_end" widget="float_time" string="Fin"/>
                        </group>
                    </group>
                    <group string="Zona horaria">
                        <field name="uy_offset" string="Offset UTC→Uruguay (horas)"
                               help="Uruguay no aplica horario de verano desde 2015: siempre -3"/>
                    </group>
                    <group string="Importación manual por rango">
                        <group>
                            <field name="date_from" string="Fecha desde"/>
                            <field name="date_to" string="Fecha hasta"/>
                        </group>
                        <group>
                            <field name="page_load_timeout" string="Timeout (seg)"/>
                        </group>
                    </group>
                    <group string="Estado">
                        <field name="last_run" string="Última ejecución"/>
                    </group>
                    <field name="last_result" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_scraper_quiniela_uy" model="ir.actions.act_window">
        <field name="name">Importador Quiniela Uruguay</field>
        <field name="res_model">lottery.scraper.quiniela.uy</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_lottery_scraper_quiniela_uy"
              name="Quiniela Uruguay"
              parent="menu_lottery_scraper_root"
              action="action_lottery_scraper_quiniela_uy"
              sequence="20"/>
</odoo>
