<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Corre cada 10 minutos y recorre TODOS los importadores de Florida
        (Pick 3 y Pick 2), cada uno con su sorteo y sus ventanas. Florida
        publica los dos juegos al mismo tiempo, así que caen en la misma
        ventana; que uno falle no frena al otro.
        El método evalúa internamente si estamos dentro de una ventana horaria ET:
          · Tarde  → 2:00 PM – 3:30 PM  ET  (configurable)
          · Noche  → 10:00 PM – 11:30 PM ET  (configurable)
        Si el sorteo del turno ya fue importado para hoy → no hace nada.
        Si el sitio aún no publicó el resultado → registra "PENDIENTE" y reintenta en 10 min.
    -->
    <record id="cron_import_lottery_results" model="ir.cron">
        <field name="name">Florida · Importar resultados diarios (Pick 3 y Pick 2)</field>
        <field name="model_id" ref="model_lottery_scraper"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_results()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="nextcall">2026-04-27 18:00:00</field>
    </record>

    <!--
        Quiniela Uruguay: corre cada 5 minutos, pero el método solo hace la
        petición al sitio si la hora actual (Uruguay) está dentro de alguna
        de las dos ventanas de publicación:
          · Vespertina → 15:00 - 16:00
          · Nocturna    → 21:00 - 22:00
        Fuera de esas ventanas, no llama a la web (evita pegarle al sitio
        todo el día). Si dentro de la ventana el resultado aún no está
        publicado, registra "PENDIENTE" y reintenta en el próximo ciclo de
        5 min, dentro de la misma ventana. Arranca inactivo: revisar y
        activar manualmente antes de dejarlo corriendo en producción.
    -->
    <!--
        New York Numbers/Win 4: data.ny.gov publica los resultados con retraso
        variable (horas, a veces recién al día siguiente), por eso no se usan
        ventanas horarias: corre cada hora, consulta desde el último sorteo
        registrado hasta hoy ET e importa lo que falte (una sola petición por
        corrida). Si el día ya está completo, no llama a la API.
        Arranca inactivo: revisar y activar manualmente tras validar.
    -->
    <record id="cron_import_new_york_results" model="ir.cron">
        <field name="name">New York · Importar resultados diarios</field>
        <field name="model_id" ref="model_lottery_scraper_new_york"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_results()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>

    <record id="cron_import_quiniela_uy_results" model="ir.cron">
        <field name="name">Quiniela UY · Importar resultados diarios</field>
        <field name="model_id" ref="model_lottery_scraper_quiniela_uy"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_results()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
