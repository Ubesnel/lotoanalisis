<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sección Tómbola dentro de Uruguay, al lado de Salidas: la Tómbola es
         de la Quiniela UY y sus atrasos van aparte de los de Atrasos > Números
         (que son por sorteo de las demás loterías). -->
    <menuitem name="Atrasos Tómbola" id="menu_tombola_root" sequence="20"
              parent="lottery_base.menu_country_uy"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_tombola_number_stat_item" name="Atrasos de números"
              parent="menu_tombola_root"
              action="action_lottery_tombola_number_stat" sequence="1"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_tombola_number_stat_turno_item" name="Atrasos por turno"
              parent="menu_tombola_root"
              action="action_lottery_tombola_number_stat_turno" sequence="2"
              groups="lottery_base.group_lottery_user"/>
</odoo>
