<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron disparado por _trigger() al guardar una salida de Tómbola:
             recalcula números y grupos fuera del request del usuario. El
             intervalo es solo una red de seguridad por si un trigger se pierde. -->
        <record id="cron_recompute_pending_tombola_stats" model="ir.cron">
            <field name="name">Recalcular estadísticas de Tómbola pendientes</field>
            <field name="model_id" ref="lottery_base.model_lottery_tombola_output"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_pending_tombola_stats()</field>
            <field name='interval_number'>10</field>
            <field name='interval_type'>minutes</field>
            <field name="numbercall">-1</field>
            <field name="priority">2</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
