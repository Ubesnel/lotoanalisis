<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Comentarios de Desarrollo ──────────────────────────────────────── -->
    <record id="view_lottery_guion_comentario_list" model="ir.ui.view">
        <field name="name">lottery.guion.comentario.list</field>
        <field name="model">lottery.guion.comentario</field>
        <field name="arch" type="xml">
            <tree string="Comentarios de Guión" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="tipo_guion"/>
                <field name="personaje"/>
                <field name="comentario"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_guion_comentario_form" model="ir.ui.view">
        <field name="name">lottery.guion.comentario.form</field>
        <field name="model">lottery.guion.comentario</field>
        <field name="arch" type="xml">
            <form string="Comentario de Guión">
                <sheet>
                    <group>
                        <field name="tipo_guion"/>
                        <field name="personaje"/>
                        <field name="sequence"/>
                        <field name="comentario"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_guion_comentario" model="ir.actions.act_window">
        <field name="name">Comentarios de Desarrollo</field>
        <field name="res_model">lottery.guion.comentario</field>
        <field name="view_mode">tree,form</field>
    </record>

