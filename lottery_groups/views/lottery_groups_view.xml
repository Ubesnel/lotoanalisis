<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_groups_tree" model="ir.ui.view">
        <field name="name">view.lottery.groups.tree</field>
        <field name="model">lottery.group</field>
        <field name="arch" type="xml">
            <tree string="Grupos" create="0" edit="0" delete="1">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="number_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_groups_form" model="ir.ui.view">
        <field name="name">lottery.groups.form</field>
        <field name="model">lottery.group</field>
        <field name="arch" type="xml">
            <form string="Grupo" create="0" edit="0" delete="1">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" class="oe_inline"/></h1>
                        <h3><field name="code" class="oe_inline"/></h3>
                    </div>
                    <notebook>
                        <page string="Números">
                            <field name="number_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Estadísticas por sorteo">
                            <field name="stat_ids">
                                <tree create="0" edit="0" delete="0" default_order="sorteo_id">
                                    <field name="sorteo_id" optional="show"/>
                                    <field name="total_salidas"/>
                                    <field name="salidas_atrasadas"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <separator string="Notas"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_groups" model="ir.actions.act_window">
        <field name="name">Grupos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Estadísticas de grupo por sorteo -->
    <record id="view_lottery_group_stat_tree" model="ir.ui.view">
        <field name="name">view.lottery.group.stat.tree</field>
        <field name="model">lottery.group.stat</field>
        <field name="arch" type="xml">
            <tree string="Estadísticas de grupos por sorteo" create="0" edit="0" delete="0"
                  default_order="sorteo_id, group_id">
                <field name="sorteo_id" optional="show"/>
                <field name="group_id"/>
                <field name="total_salidas" optional="hide"/>
                <field name="salidas_atrasadas"/>
                <field name="salidas_atrasadas_lunes" optional="hide"/>
                <field name="salidas_atrasadas_martes" optional="hide"/>
                <field name="salidas_atrasadas_miercoles" optional="hide"/>
                <field name="salidas_atrasadas_jueves" optional="hide"/>
                <field name="salidas_atrasadas_viernes" optional="hide"/>
                <field name="salidas_atrasadas_sabado" optional="hide"/>
                <field name="salidas_atrasadas_domingo" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_group_stat_form" model="ir.ui.view">
        <field name="name">lottery.group.stat.form</field>
        <field name="model">lottery.group.stat</field>
        <field name="arch" type="xml">
            <form string="Estadísticas del grupo" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="group_id"/>
                            <field name="sorteo_id"/>
                        </group>
                        <group>
                            <field name="total_salidas"/>
                            <field name="salidas_atrasadas"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Por turno" name="por_turno">
                            <field name="turno_stat_ids">
                                <tree>
                                    <field name="turno_id"/>
                                    <field name="total_salidas"/>
                                    <field name="salidas_atrasadas"/>
                                    <field name="ultima_fecha"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Por día de la semana" name="por_dia">
                            <group>
                                <group string="Salidas">
                                    <field name="total_lunes"/>
                                    <field name="total_martes"/>
                                    <field name="total_miercoles"/>
                                    <field name="total_jueves"/>
                                    <field name="total_viernes"/>
                                    <field name="total_sabado"/>
                                    <field name="total_domingo"/>
                                </group>
                                <group string="Atraso (semanas)">
                                    <field name="salidas_atrasadas_lunes"/>
                                    <field name="salidas_atrasadas_martes"/>
                                    <field name="salidas_atrasadas_miercoles"/>
                                    <field name="salidas_atrasadas_jueves"/>
                                    <field name="salidas_atrasadas_viernes"/>
                                    <field name="salidas_atrasadas_sabado"/>
                                    <field name="salidas_atrasadas_domingo"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lottery_group_stat_search" model="ir.ui.view">
        <field name="name">lottery.group.stat.search</field>
        <field name="model">lottery.group.stat</field>
        <field name="arch" type="xml">
            <search string="Estadísticas de grupos">
                <field name="group_id"/>
                <field name="sorteo_id"/>
                <filter string="Florida" name="filter_sorteo_florida" domain="[('sorteo_id.code', '=', 'florida')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sorteo" name="group_sorteo_id" domain="[]" context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Grupo" name="group_group" domain="[]" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lottery_group_stat" model="ir.actions.act_window">
        <field name="name">Atrasos de grupos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.group.stat</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_sorteo_florida': 1}</field>
        <field name="search_view_id" ref="view_lottery_group_stat_search"/>
    </record>

    <!-- Atrasos de grupos por turno: una fila por grupo, sorteo y turno. -->
    <record id="view_lottery_group_stat_turno_tree" model="ir.ui.view">
        <field name="name">view.lottery.group.stat.turno.tree</field>
        <field name="model">lottery.group.stat.turno</field>
        <field name="arch" type="xml">
            <tree string="Atrasos de grupos por turno" create="0" edit="0" delete="0">
                <field name="sorteo_id" optional="show"/>
                <field name="turno_id"/>
                <field name="group_id"/>
                <field name="total_salidas"/>
                <field name="salidas_atrasadas"/>
                <field name="ultima_fecha"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_group_stat_turno_search" model="ir.ui.view">
        <field name="name">lottery.group.stat.turno.search</field>
        <field name="model">lottery.group.stat.turno</field>
        <field name="arch" type="xml">
            <search string="Atrasos de grupos por turno">
                <field name="group_id"/>
                <field name="sorteo_id"/>
                <field name="turno_id"/>
                <filter string="Florida" name="filter_sorteo_florida" domain="[('sorteo_id.code', '=', 'florida')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sorteo" name="group_sorteo_id" domain="[]" context="{'group_by': 'sorteo_id'}"/>
                    <filter string="Turno" name="group_turno_id" domain="[]" context="{'group_by': 'turno_id'}"/>
                    <filter string="Grupo" name="group_group" domain="[]" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lottery_group_stat_turno" model="ir.actions.act_window">
        <field name="name">Atrasos de grupos por turno</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.group.stat.turno</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_filter_sorteo_florida': 1, 'search_default_group_turno_id': 1}</field>
        <field name="search_view_id" ref="view_lottery_group_stat_turno_search"/>
    </record>
</odoo>
