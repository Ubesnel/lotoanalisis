                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_lottery_groups" model="ir.actions.act_window">
        <field name="name">Grupos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.group</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_lottery_groups_kanban"/>
    </record>
</odoo>
