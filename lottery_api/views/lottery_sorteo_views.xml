<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_sorteo_form_api" model="ir.ui.view">
        <field name="name">lottery.sorteo.form.api</field>
        <field name="model">lottery.sorteo</field>
        <field name="inherit_id" ref="lottery_portal.view_lottery_sorteo_form_ranking"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_in_public']" position="after">
                <field name="show_in_app"/>
                <field name="proximo_tabla_app"/>
                <field name="auto_prediction"/>
                <field name="auto_prediction_publish" invisible="not auto_prediction"/>
                <field name="auto_prediction_delay" invisible="not auto_prediction"/>
                <field name="auto_prediction_error" invisible="not auto_prediction_error"/>
            </xpath>
        </field>
    </record>
</odoo>
