<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_prediction_premium_tree" model="ir.ui.view">
        <field name="name">lottery.prediction.premium.tree</field>
        <field name="model">lottery.prediction.premium</field>
        <field name="arch" type="xml">
            <tree decoration-success="acierto_alguno" decoration-muted="evaluada and not acierto_alguno">
                <field name="acierto_alguno" column_invisible="1"/>
                <field name="date"/>
                <field name="turno_id"/>
                <field name="sorteo_id"/>
                <field name="linea_top"/>
                <field name="terminal_top"/>
                <field name="number_ids" widget="many2many_tags"/>
                <field name="published" widget="boolean_toggle"/>
                <field name="evaluada" optional="show"/>
                <field name="resultado" optional="show"/>
                <field name="acierto_linea" optional="show"/>
                <field name="acierto_terminal" optional="show"/>
                <field name="acierto_fuerte" optional="show"/>
                <field name="acierto_centena" optional="hide"/>
                <field name="acierto_terna" optional="show"/>
                <field name="acierto_parle" optional="show"/>
                <field name="acierto_tombola" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_prediction_premium_form" model="ir.ui.view">
        <field name="name">lottery.prediction.premium.form</field>
        <field name="model">lottery.prediction.premium</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_completar" type="object"
                            string="Completar" class="btn-primary"
                            invisible="published"
                            help="Línea y terminal top de Recomendados, números fuertes desde la predicción del día, ternas top, parlés top y una tómbola de cada tamaño (Quiniela UY)."/>
                    <button name="action_send_push_notification" type="object"
                            string="Enviar notificación push" class="btn-primary"
                            icon="fa-bell" invisible="not id or push_sent or not published"
                            confirm="Se enviará una notificación push a los usuarios de la app avisando que ya está la Predicción Premium de este sorteo. ¿Confirma el envío?"/>
                    <field name="push_sent" invisible="1"/>
                    <button name="action_evaluar" type="object" string="Evaluar"
                            confirm="Se recalculan los aciertos desde la salida y se pierden los marcados a mano. ¿Seguir?"
                            invisible="not evaluacion_manual"/>
                    <button name="action_evaluar" type="object" string="Evaluar"
                            invisible="evaluacion_manual"
                            help="Vuelve a comparar contra la salida del mismo sorteo, fecha y turno. Se hace solo al registrar la salida."/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="alert" invisible="not push_sent">
                        Notificación enviada el <field name="push_sent_date" readonly="1" nolabel="1"/>.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not tombola_push_sent">
                        Aviso de tómbola acertada enviado.
                        <field name="tombola_push_sent" invisible="1"/>
                    </div>
                    <widget name="web_ribbon" title="Con acierto" bg_color="text-bg-success"
                            invisible="not acierto_alguno"/>
                    <widget name="web_ribbon" title="Sin acierto" bg_color="text-bg-danger"
                            invisible="not evaluada or acierto_alguno"/>
                    <widget name="web_ribbon" title="Sin evaluar" bg_color="text-bg-secondary"
                            invisible="evaluada"/>
                    <group>
                        <group>
                            <field name="sorteo_id" readonly="evaluada" options="{'no_create': True}"/>
                            <field name="date" readonly="evaluada"/>
                            <field name="turno_id" readonly="evaluada" options="{'no_create': True}"/>
                            <field name="sorteo_turno_ids" invisible="1"/>
                            <field name="sorteo_uses_hundreds" invisible="1"/>
                            <field name="sorteo_generates_parles" invisible="1"/>
                            <field name="sorteo_code" invisible="1"/>
                        </group>
                        <group>
                            <field name="published"/>
                            <field name="published_date"/>
                            <field name="prediction_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluación" name="evaluacion">
                            <group>
                                <group>
                                    <field name="evaluada"/>
                                    <field name="evaluacion_manual" invisible="not evaluada" readonly="1"/>
                                    <field name="evaluation_date" invisible="not evaluada"/>
                                    <field name="output_id" invisible="not evaluada"/>
                                    <field name="resultado" invisible="not evaluada"/>
                                    <field name="acierto_alguno" invisible="1"/>
                                </group>
                                <group invisible="not evaluada">
                                    <field name="acierto_linea"/>
                                    <field name="acierto_terminal"/>
                                    <field name="acierto_fuerte"/>
                                    <field name="acierto_centena" invisible="not sorteo_uses_hundreds"/>
                                    <field name="acierto_terna" invisible="not sorteo_uses_hundreds"/>
                                    <field name="acierto_parle" invisible="not sorteo_generates_parles"/>
                                    <field name="acierto_tombola" invisible="sorteo_code != 'quiniela_uy_1'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Línea, terminal y números fuertes" name="linea_terminal">
                            <group>
                                <group>
                                    <field name="linea_top" readonly="evaluada"/>
                                    <field name="terminal_top" readonly="evaluada"/>
                                </group>
                                <group>
                                    <field name="number_ids" readonly="evaluada" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ternas top y centenas" name="ternas"
                              invisible="not sorteo_uses_hundreds">
                            <group>
                                <group string="Centenas">
                                    <field name="centena_top_1" readonly="evaluada"/>
                                    <field name="centena_top_2" readonly="evaluada"/>
                                </group>
                                <group string="Ternas top">
                                    <field name="terna_ids" readonly="evaluada" nolabel="1" colspan="2">
                                        <tree editable="bottom">
                                            <field name="terna"/>
                                        </tree>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="Parlés top" name="parles"
                              invisible="not sorteo_generates_parles">
                            <field name="parle_ids" readonly="evaluada" nolabel="1" colspan="2">
                                <tree editable="bottom" decoration-bf="destacado">
                                    <field name="sequence" widget="handle"/>
                                    <field name="numero_1" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_2" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="destacado"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tómbolas" name="tombolas"
                              invisible="sorteo_code != 'quiniela_uy_1'">
                            <field name="tombola_linea_ids" readonly="evaluada" nolabel="1" colspan="2">
                                <tree editable="bottom" decoration-success="acertada">
                                    <field name="numero_1" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_2" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_3" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_4" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_5" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_6" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="numero_7" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="aciertos"/>
                                    <field name="acertada"/>
                                    <field name="completa"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lottery_prediction_premium_search" model="ir.ui.view">
        <field name="name">lottery.prediction.premium.search</field>
        <field name="model">lottery.prediction.premium</field>
        <field name="arch" type="xml">
            <search>
                <field name="sorteo_id"/>
                <field name="date"/>
                <filter name="sin_publicar" string="Sin publicar" domain="[('published', '=', False)]"/>
                <filter name="publicadas" string="Publicadas" domain="[('published', '=', True)]"/>
                <separator/>
                <filter name="evaluadas" string="Evaluadas" domain="[('evaluada', '=', True)]"/>
                <filter name="sin_evaluar" string="Sin evaluar" domain="[('evaluada', '=', False)]"/>
                <filter name="manual" string="Marcadas a mano" domain="[('evaluacion_manual', '=', True)]"/>
                <separator/>
                <filter name="con_acierto" string="Con acierto" domain="[('acierto_alguno', '=', True)]"/>
                <filter name="sin_acierto" string="Sin acierto" domain="[('evaluada', '=', True), ('acierto_alguno', '=', False)]"/>
                <separator/>
                <filter name="f_linea" string="Acertó línea" domain="[('acierto_linea', '=', True)]"/>
                <filter name="f_terminal" string="Acertó terminal" domain="[('acierto_terminal', '=', True)]"/>
                <filter name="f_fuerte" string="Acertó número fuerte" domain="[('acierto_fuerte', '=', True)]"/>
                <filter name="f_terna" string="Acertó terna" domain="[('acierto_terna', '=', True)]"/>
                <filter name="f_parle" string="Acertó parlé" domain="[('acierto_parle', '=', True)]"/>
                <filter name="f_centena" string="Acertó centena" domain="[('acierto_centena', '=', True)]"/>
                <filter name="f_tombola" string="Acertó tómbola" domain="[('acierto_tombola', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_sorteo" string="Sorteo" context="{'group_by': 'sorteo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lottery_prediction_premium" model="ir.actions.act_window">
        <field name="name">Predicciones Premium</field>
        <field name="res_model">lottery.prediction.premium</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_lottery_prediction_premium"
              name="Predicciones Premium"
              parent="menu_premium_root"
              action="action_lottery_prediction_premium"
              groups="lottery_base.group_lottery_manager"
              sequence="5"/>
</odoo>
