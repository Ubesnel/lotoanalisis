<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view_api">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="lottery_portal.res_config_settings_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='lottery']" position="inside">
                <block title="App móvil LotoAnálisis" id="lottery_api_settings">
                    <setting string="Tabla del Próximo Sorteo"
                             help="Ranking que la app muestra en 'Próximo Sorteo · Mejores números por líneas': Calientes, Restantes o Fríos. La app siempre muestra lo que esté configurado aquí.">
                        <field name="lottery_api_proximo_tabla"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
