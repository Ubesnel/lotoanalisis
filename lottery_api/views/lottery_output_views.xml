<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_output_form_api" model="ir.ui.view">
        <field name="name">lottery.output.form.api</field>
        <field name="model">lottery.output</field>
        <field name="inherit_id" ref="lottery_base.view_lottery_output_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_push_notification" type="object"
                            string="Enviar notificación push" class="btn-primary"
                            icon="fa-bell" invisible="not id or push_sent"
                            confirm="Se enviará una notificación push a los usuarios de la app con este resultado. Verifique que el número sea correcto antes de continuar. ¿Confirma el envío?"/>
                    <field name="push_sent" invisible="1"/>
                </header>
            </xpath>
            <xpath expr="//group" position="before">
                <div class="alert alert-success" role="alert" invisible="not push_sent">
                    Notificación enviada el <field name="push_sent_date" readonly="1" nolabel="1"/>.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
