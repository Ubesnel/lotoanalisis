<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_lottery_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.lottery.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Agrega los bloques de la app LotoAnálisis dentro del <app> "Loterías" de lottery_portal -->
            <xpath expr="//app[@name='lottery_portal']" position="inside">
                <block title="Notificaciones Push (FCM)" id="lottery_api_fcm_settings">
                    <setting string="Cuenta de servicio Firebase (JSON)"
                             help="Pega el JSON completo de la service account descargada de Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada. No incluir en el repositorio.">
                        <field name="fcm_service_account"
                               widget="text"
                               placeholder='{"type":"service_account","project_id":"...","private_key":"...",...}'
                               style="font-family:monospace;font-size:11px;height:120px;width:100%;"/>
                    </setting>
                </block>
                <block title="LotoAnálisis Premium" id="lottery_api_premium_settings">
                    <setting string="Cuenta de servicio Google Play (JSON)"
                             help="JSON de la cuenta play-premium (Google Cloud → IAM → Cuentas de servicio → Claves). Valida las compras de Premium. No incluir en el repositorio.">
                        <field name="play_service_account"
                               widget="text"
                               placeholder='{"type":"service_account","project_id":"...","private_key":"...",...}'
                               style="font-family:monospace;font-size:11px;height:120px;width:100%;"/>
                    </setting>
                    <setting string="Paquete de la app"
                             help="Nombre del paquete en Google Play.">
                        <field name="play_package_name"/>
                    </setting>
                    <setting string='"LotoAnálisis informa" es Premium'
                             help="El texto de las noticias solo llega a quien tiene Premium. Prenderlo cuando la mayoría tenga la versión con Premium: las anteriores verían las noticias vacías.">
                        <field name="lottery_informa_premium"/>
                    </setting>
                    <setting string="Mágicos 10/5/Súper son Premium"
                             help="Apagado, todos ven las tablas de 10 y 5, el Súper Mágico y los parlés del próximo sorteo, como antes de Premium. Prenderlo cuando la 42 esté al 100% y el build mínimo en 42.">
                        <field name="lottery_magicos_premium"/>
                    </setting>
                    <setting string="Aviso de Premium en la app"
                             help="Cada tantos días la app invita a pasarse a Premium. Nunca a quien ya es Premium ni a quien no puede pagar con Google Play. Si el usuario lo descarta, la app lo espacia más.">
                        <field name="lottery_premium_promo"/>
                        <div class="mt8" invisible="not lottery_premium_promo">
                            Cada <field name="lottery_premium_promo_days" class="oe_inline"/> días
                        </div>
                    </setting>
                    <setting string="Números de la Suerte"
                             help="Se generan solos a esta hora de Uruguay, y desde esa hora la app muestra los del día nuevo. Antes sigue con los del día anterior.">
                        <div>Hora <field name="lottery_suerte_hora" widget="float_time" class="oe_inline"/></div>
                        <div>Sorteo de referencia <field name="lottery_suerte_sorteo_id" class="oe_inline" options="{'no_create': True}"/></div>
                        <div>Temperatura <field name="lottery_suerte_temperature" class="oe_inline"/></div>
                        <div>Publicar al generarlos <field name="lottery_suerte_publicar" class="oe_inline"/></div>
                    </setting>
                </block>
                <block title="Historial de Predicciones" id="lottery_api_historial_settings">
                    <setting string="Mostrar predicciones desde"
                             help="Solo se muestran en la app las predicciones publicadas a partir de esta fecha. Dejá en blanco para mostrar todas.">
                        <field name="lottery_historial_desde"/>
                    </setting>
                </block>
                <block title="Actualización obligatoria" id="lottery_api_min_build_settings">
                    <setting string="Build mínimo requerido"
                             help="Versión mínima (versionCode/buildNumber de Android) que debe tener la app instalada. Un usuario con una versión menor ve una pantalla de actualización obligatoria hasta que actualice desde Play Store. 0 = no exigir ninguna versión mínima.">
                        <field name="lottery_min_build_number"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
