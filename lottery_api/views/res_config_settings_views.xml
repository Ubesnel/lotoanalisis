<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_lottery_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.lottery.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_setting_box')][last()]" position="after">
                <div class="app_settings_block">
                    <h2>App LotoAnálisis — Notificaciones Push</h2>
                    <div class="row mt16">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="fcm_service_account"
                                       string="Cuenta de servicio Firebase (JSON)"/>
                                <div class="text-muted">
                                    Pega el JSON completo de la service account descargada
                                    de Firebase Console → Configuración del proyecto →
                                    Cuentas de servicio → Generar nueva clave privada.
                                    No incluir en el repositorio.
                                </div>
                                <field name="fcm_service_account"
                                       widget="text"
                                       placeholder='{"type":"service_account","project_id":"...","private_key":"...",...}'
                                       style="font-family:monospace;font-size:11px;height:120px;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
