<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista lista ── -->
    <record id="view_lottery_premium_pass_list" model="ir.ui.view">
        <field name="name">lottery.premium.pass.tree</field>
        <field name="model">lottery.premium.pass</field>
        <field name="arch" type="xml">
            <tree string="Pases Premium" create="false"
                  decoration-success="state in ('active', 'grace')"
                  decoration-warning="state in ('on_hold', 'canceled', 'pending', 'paused')"
                  decoration-muted="state in ('expired', 'replaced', 'revoked')">
                <field name="create_date" string="Alta"/>
                <field name="origin"/>
                <field name="base_plan_id"/>
                <field name="state"/>
                <field name="expiry_date"/>
                <field name="auto_renewing" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="is_test" optional="show"/>
                <field name="acknowledged" optional="hide"/>
                <field name="last_check" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ── Vista formulario ── -->
    <record id="view_lottery_premium_pass_form" model="ir.ui.view">
        <field name="name">lottery.premium.pass.form</field>
        <field name="model">lottery.premium.pass</field>
        <field name="arch" type="xml">
            <form string="Pase Premium" create="false">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,canceled,expired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Pase">
                            <field name="origin" readonly="1"/>
                            <field name="is_premium"/>
                            <field name="expiry_date" readonly="1"/>
                            <field name="auto_renewing" readonly="1"/>
                            <field name="is_test" readonly="1"/>
                        </group>
                        <group string="Google Play">
                            <field name="product_id" readonly="1"/>
                            <field name="base_plan_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="acknowledged" readonly="1"/>
                            <field name="last_check" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Respuesta de Google" name="google">
                            <field name="google_response" readonly="1"
                                   style="font-family:monospace;font-size:11px;"/>
                        </page>
                        <page string="Tokens" name="tokens">
                            <group>
                                <field name="purchase_token" readonly="1"/>
                                <field name="linked_purchase_token" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Búsqueda ── -->
    <record id="view_lottery_premium_pass_search" model="ir.ui.view">
        <field name="name">lottery.premium.pass.search</field>
        <field name="model">lottery.premium.pass</field>
        <field name="arch" type="xml">
            <search string="Buscar pases">
                <field name="order_id"/>
                <field name="purchase_token"/>
                <separator/>
                <filter name="vigentes" string="Con acceso"
                        domain="[('state', 'in', ('active', 'grace', 'canceled'))]"/>
                <filter name="reales" string="Sin compras de prueba" domain="[('is_test', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'base_plan_id'}"/>
                    <filter name="group_origin" string="Origen" context="{'group_by': 'origin'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción ── -->
    <record id="action_lottery_premium_pass" model="ir.actions.act_window">
        <field name="name">Pases Premium</field>
        <field name="res_model">lottery.premium.pass</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_vigentes': 1}</field>
    </record>

    <!-- ── Menú: sección LotoAnálisis Premium, al lado de LotoAnálisis.
         Acá se van colgando los códigos de regalo y lo que venga. ── -->
    <menuitem id="menu_premium_root"
              name="LotoAnálisis Premium"
              parent="lottery_base.home_lottery"
              groups="lottery_base.group_lottery_manager"
              sequence="11"/>

    <menuitem id="menu_lottery_premium_pass"
              name="Pases Premium"
              parent="menu_premium_root"
              action="action_lottery_premium_pass"
              groups="lottery_base.group_lottery_manager"
              sequence="10"/>

    <!-- Curiosidades alimenta "LotoAnálisis informa", que pasa a Premium. -->
    <menuitem id="menu_premium_curiosity"
              name="Curiosidades"
              parent="menu_premium_root"
              action="lottery_portal.action_lottery_curiosity"
              groups="lottery_base.group_lottery_manager"
              sequence="20"/>

</odoo>
