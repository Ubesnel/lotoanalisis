<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Genera los Números de la Suerte del día pasada la hora de Ajustes
         (6:00 de Uruguay por defecto). Si ya hay unos para esa fecha, no hace nada. -->
    <record id="ir_cron_lottery_numeros_suerte" model="ir.cron">
        <field name="name">Lottery API: generar Números de la Suerte del día</field>
        <field name="model_id" ref="lottery_portal.model_lottery_numeros_suerte"/>
        <field name="state">code</field>
        <field name="code">model._cron_generar_del_dia()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
