<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Crea la Predicción Premium del próximo sorteo y recalcula las que
         todavía no están publicadas (las publicadas no se tocan). -->
    <record id="ir_cron_lottery_prediction_premium" model="ir.cron">
        <field name="name">Lottery API: preparar Predicción Premium</field>
        <field name="model_id" ref="model_lottery_prediction_premium"/>
        <field name="state">code</field>
        <field name="code">model._cron_preparar_proximo_sorteo()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
