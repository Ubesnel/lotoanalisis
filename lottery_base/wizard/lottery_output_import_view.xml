<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_output_import_form" model="ir.ui.view">
        <field name="name">lottery.output.import.form</field>
        <field name="model">lottery.output.import</field>
        <field name="arch" type="xml">
            <form string="Importar salidas desde Excel">
                <div class="alert alert-info" role="alert">
                    La primera hoja del Excel tiene que traer en la primera fila las
                    columnas <strong>Fecha</strong>, <strong>Turno</strong> y
                    <strong>Número</strong> (y <strong>Centena</strong> si el sorteo la usa;
                    <strong>Premio 2</strong> y <strong>Premio 3</strong> si es una quiniela con corridos).
                    Las demás columnas se ignoran.
                    <br/>
                    Turno: código (morning, afternoon, evening…) o nombre (Mañana, Tarde,
                    Noche…), y solo de los turnos del sorteo. Las salidas que ya existen se
                    saltean. Si hay errores no se importa nada.
                </div>
                <group>
                    <field name="sorteo_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'validated'">
                    <field name="summary" nolabel="1"/>
                </div>
                <div class="alert alert-success" role="alert" invisible="state != 'imported'">
                    <field name="summary" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                    <field name="summary" nolabel="1"/>
                    <field name="errors" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_validate" string="Validar" type="object"
                            class="btn-secondary" icon="fa-check"/>
                    <button name="action_import" string="Importar" type="object"
                            class="btn-primary" icon="fa-upload"
                            confirm="Se van a crear las salidas del archivo en el sorteo elegido. ¿Continuar?"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lottery_output_import" model="ir.actions.act_window">
        <field name="name">Importar salidas (Excel)</field>
        <field name="res_model">lottery.output.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
