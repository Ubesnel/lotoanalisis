<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lottery_output_sorteo" model="ir.rule">
            <field name="name">Salidas: solo sorteos permitidos</field>
            <field name="model_id" ref="model_lottery_output"/>
            <field name="domain_force">[('sorteo_id', 'in', user.sorteo_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('lottery_base.group_lottery_user'))]"/>
        </record>

        <record id="rule_lottery_sorteo_visible" model="ir.rule">
            <field name="name">Sorteos: solo los permitidos al usuario</field>
            <field name="model_id" ref="model_lottery_sorteo"/>
            <field name="domain_force">[('id', 'in', user.sorteo_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('lottery_base.group_lottery_user'))]"/>
        </record>

        <!-- Las reglas de grupo se combinan con OR: los administradores de
             lotería ven todos los sorteos y salidas sin depender de su lista
             personal sorteo_ids (si no, ni siquiera podrían asignarse un
             sorteo nuevo, porque el desplegable también se filtra). -->
        <record id="rule_lottery_sorteo_manager_all" model="ir.rule">
            <field name="name">Sorteos: administradores ven todo</field>
            <field name="model_id" ref="model_lottery_sorteo"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('lottery_base.group_lottery_manager'))]"/>
        </record>
        <record id="rule_lottery_output_manager_all" model="ir.rule">
            <field name="name">Salidas: administradores ven todo</field>
            <field name="model_id" ref="model_lottery_output"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('lottery_base.group_lottery_manager'))]"/>
        </record>
    </data>
</odoo>
