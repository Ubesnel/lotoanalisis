<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="category_lottery" model="ir.module.category">
            <field name="name">Lotería</field>
        </record>

        <record id="group_lottery_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="lottery_base.category_lottery"/>
        </record>

        <record id="group_lottery_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="lottery_base.category_lottery"/>
            <field name="implied_ids" eval="[(4, ref('lottery_base.group_lottery_user'))]"/>
        </record>

    </data>
</odoo>