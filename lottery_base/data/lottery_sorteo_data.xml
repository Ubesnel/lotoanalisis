<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sorteo_florida" model="lottery.sorteo">
            <field name="name">Florida</field>
            <field name="code">florida</field>
            <field name="sequence">1</field>
            <field name="uses_fireball" eval="True"/>
            <field name="enforce_turn_continuity" eval="True"/>
            <field name="source_code">florida</field>
        </record>
        <record id="sorteo_new_york" model="lottery.sorteo">
            <field name="name">New York</field>
            <field name="code">new_york</field>
            <field name="sequence">2</field>
            <field name="uses_fireball" eval="False"/>
            <!-- Histórico 1980-2001 solo tiene turno Noche: la continuidad
                 Tarde→Noche rompería la importación de esos años. -->
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="is_pick3" eval="True"/>
            <field name="source_code">new_york</field>
        </record>
        <!-- Florida Pick 2: número de 2 dígitos (00-99), SIN centena.
             Nació el 01/08/2016 y comparte la Fireball con Pick 3 / Pick 4,
             por eso no se registra acá (ya está en el sorteo Florida). -->
        <record id="sorteo_florida_pick2" model="lottery.sorteo">
            <field name="name">Florida Pick 2</field>
            <field name="code">florida_pick2</field>
            <field name="sequence">3</field>
            <field name="uses_hundreds" eval="False"/>
            <field name="uses_fireball" eval="False"/>
            <field name="is_pick3" eval="False"/>
            <!-- En False a propósito: el primer sorteo del histórico (01/08/2016)
                 es de Tarde, y la continuidad exige una Noche del día anterior
                 que no existe → rompería el backfill en el primer registro. -->
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="source_code">florida_pick2</field>
        </record>
        <!-- La Primera (Rep. Dominicana): quiniela de 3 números de 2 dígitos.
             Premio 1 = fijo (number_id), premios 2 y 3 = corridos. Sin centena
             y sin bola extra. Turnos 12:00pm y 07:00pm (hora RD). -->
        <record id="sorteo_la_primera" model="lottery.sorteo">
            <field name="name">La Primera</field>
            <field name="code">la_primera</field>
            <field name="sequence">4</field>
            <field name="uses_hundreds" eval="False"/>
            <field name="uses_fireball" eval="False"/>
            <field name="is_pick3" eval="True"/>
            <!-- En False: el histórico oficial arranca el 18/02/2023 y puede
                 tener días incompletos; la continuidad rompería el backfill. -->
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="source_code">la_primera</field>
        </record>
        <!-- La Suerte Dominicana: misma mecánica que La Primera.
             Turnos 12:30 ("Día") y 18:00 (que la fuente llama "Tarde"). -->
        <record id="sorteo_la_suerte" model="lottery.sorteo">
            <field name="name">La Suerte</field>
            <field name="code">la_suerte</field>
            <field name="sequence">5</field>
            <field name="uses_hundreds" eval="False"/>
            <field name="uses_fireball" eval="False"/>
            <field name="is_pick3" eval="True"/>
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="source_code">conectate</field>
        </record>
        <!-- King Lottery (Sint Maarten, no dominicana). Mismo formato que las
             quinielas: 3 números de 2 dígitos = premios 1, 2 y 3. En la fuente
             los campos se llaman "2&amp;3 Pick 3", "1&amp;2 Pick 4" y "3&amp;4 Pick 4"
             porque los arman con dígitos de un Pick 3 y un Pick 4, pero el dato
             que llega y se guarda es idéntico. -->
        <record id="sorteo_king_lottery" model="lottery.sorteo">
            <field name="name">King Lottery</field>
            <field name="code">king_lottery</field>
            <field name="sequence">6</field>
            <field name="uses_hundreds" eval="False"/>
            <field name="uses_fireball" eval="False"/>
            <field name="is_pick3" eval="True"/>
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="source_code">conectate</field>
        </record>
        <!-- Quinielón (Rep. Dominicana): mismo formato que Florida Pick 2 —
             un número de 2 dígitos (00-99), sin centena y sin bola extra.
             Misma fuente que La Primera (laprimera.do), pero el juego
             recién aparece en el feed desde el 20/05/2024, así que su
             histórico empieza más tarde que el de La Primera. Turnos
             12:00pm y 07:00pm (hora RD). -->
        <record id="sorteo_quinielon" model="lottery.sorteo">
            <field name="name">Quinielón</field>
            <field name="code">quinielon</field>
            <field name="sequence">7</field>
            <field name="uses_hundreds" eval="False"/>
            <field name="uses_fireball" eval="False"/>
            <field name="is_pick3" eval="False"/>
            <!-- En False: el histórico de este juego tiene huecos (ver
                 lottery_scraper_quinielon.py) que romperían la continuidad. -->
            <field name="enforce_turn_continuity" eval="False"/>
            <field name="source_code">quinielon</field>
        </record>
