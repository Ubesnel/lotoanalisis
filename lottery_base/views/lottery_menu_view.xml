<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem name="Loterías" id="home_lottery" sequence="22"
              web_icon="lottery_base,static/description/icon.png"
              groups="lottery_base.group_lottery_user"/>

    <!-- 1) NÚMEROS -->
    <menuitem name="Números" id="menu_numeros_root" sequence="10"
              parent="lottery_base.home_lottery"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_number_item" name="Números"
              parent="lottery_base.menu_numeros_root"
              action="action_lottery_number" sequence="1"
              groups="lottery_base.group_lottery_user"/>
    <!-- "Atrasos de números" se agrega aquí desde lottery_delays_number -->

    <!-- 2) GRUPOS se agrega completo desde lottery_groups -->

    <!-- 3) SALIDAS -->
    <menuitem name="Salidas" id="menu_lottery_output" sequence="5"
              parent="lottery_base.home_lottery"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_output_all_item" parent="lottery_base.menu_lottery_output"
              action="action_lottery_output_all" sequence="5"
              groups="lottery_base.group_lottery_manager"/>

    <!-- 4) SORTEOS DENTRO DE SALIDAS -->
    <menuitem id="menu_lottery_output_florida_item" name="Florida Pick3"
              parent="lottery_base.menu_lottery_output"
              action="lottery_base.action_lottery_output_florida" sequence="10"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_output_new_york_item" name="New York"
              parent="lottery_base.menu_lottery_output"
              action="lottery_base.action_lottery_output_new_york" sequence="15"
              groups="lottery_base.group_lottery_user"/>

    <menuitem id="menu_lottery_output_quiniela_uy_1_item" name="Quiniela UY Premio 1"
              parent="lottery_base.menu_lottery_output"
              action="lottery_base.action_lottery_output_quiniela_uy_1" sequence="20"
              groups="lottery_base.group_lottery_user"/>

    <!-- 5) CONFIGURACIÓN -->
    <menuitem name="Configuración" id="menu_configuracion_root" sequence="100"
              parent="lottery_base.home_lottery"
              groups="lottery_base.group_lottery_manager"/>

    <!-- "Importadores" se agrega aquí desde lottery_scraper -->

    <menuitem id="menu_lottery_sorteo_item" name="Sorteos"
              parent="lottery_base.menu_configuracion_root"
              action="action_lottery_sorteo" sequence="20"
              groups="lottery_base.group_lottery_manager"/>

    <menuitem id="menu_ir_cron_act_lottery"
            parent="lottery_base.menu_configuracion_root" name="Acciones planificadas"
            action="base.ir_cron_act"
            sequence="30"/>

</odoo>
