<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_sorteo_tree" model="ir.ui.view">
        <field name="name">view.lottery.sorteo.tree</field>
        <field name="model">lottery.sorteo</field>
        <field name="arch" type="xml">
            <tree string="Sorteos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="uses_hundreds"/>
                <field name="uses_fireball"/>
                <field name="enforce_turn_continuity"/>
                <field name="source_code"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_sorteo_form" model="ir.ui.view">
        <field name="name">lottery.sorteo.form</field>
        <field name="model">lottery.sorteo</field>
        <field name="arch" type="xml">
            <form string="Sorteo">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="uses_hundreds"/>
                            <field name="uses_fireball"/>
                            <field name="enforce_turn_continuity"/>
                            <field name="is_pick3"/>
                            <field name="source_code"/>
                        </group>
                    </group>
                    <group string="Próximo sorteo (lo que muestra el portal)">
                        <group>
                            <field name="next_draw_date"/>
                            <field name="next_draw_turn"/>
                        </group>
                        <group>
                            <field name="next_draw_manual"/>
                            <div class="text-muted" colspan="2">
                                Se recalcula solo desde la última salida y el calendario.
                                Si lo editás a mano, queda manual hasta que se registre esa salida.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Calendario (días y turnos)">
                            <field name="slot_ids">
                                <tree editable="bottom">
                                    <field name="dow"/>
                                    <field name="turn"/>
                                </tree>
                            </field>
                            <div class="text-muted">
                                Días y turnos en que se juega este sorteo. Vacío = todos los días, ambos turnos.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lottery_sorteo" model="ir.actions.act_window">
        <field name="name">Sorteos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.sorteo</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
