<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lottery_turno_tree" model="ir.ui.view">
        <field name="name">view.lottery.turno.tree</field>
        <field name="model">lottery.turno</field>
        <field name="arch" type="xml">
            <tree string="Turnos" editable="bottom">
                <field name="sequence"/>
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="color" widget="color"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_lottery_turno_search" model="ir.ui.view">
        <field name="name">lottery.turno.search</field>
        <field name="model">lottery.turno</field>
        <field name="arch" type="xml">
            <search string="Turnos">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_lottery_turno" model="ir.actions.act_window">
        <field name="name">Turnos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lottery.turno</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
