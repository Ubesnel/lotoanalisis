<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rifazo_app_release_tree" model="ir.ui.view">
        <field name="name">rifazo.app.release.tree</field>
        <field name="model">rifazo.app.release</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not published">
                <field name="name"/>
                <field name="version_code"/>
                <field name="release_date"/>
                <field name="file_size_label"/>
                <field name="download_count" sum="Total"/>
                <field name="published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_rifazo_app_release_form" model="ir.ui.view">
        <field name="name">rifazo.app.release.form</field>
        <field name="model">rifazo.app.release</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Subí el APK de <strong>release</strong> (no el de debug). La página
                        <a href="/rifazo" target="_blank">/rifazo</a> ofrece siempre la versión publicada
                        con el número de build más alto, y <code>/rifazo/descargar</code> la baja directo.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="1.0.0"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="version_code"/>
                            <field name="apk_file" filename="apk_filename"/>
                            <field name="apk_filename" invisible="1"/>
                            <field name="file_size_label"/>
                        </group>
                        <group>
                            <field name="release_date"/>
                            <field name="published" widget="boolean_toggle"/>
                            <field name="download_count"/>
                        </group>
                    </group>
                    <field name="release_notes" placeholder="Qué trae esta versión (se muestra en la página de descarga)"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rifazo_app_release" model="ir.actions.act_window">
        <field name="name">Versiones de la app</field>
        <field name="res_model">rifazo.app.release</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Subí la primera versión de la APK</p>
            <p>Se descarga desde la página pública /rifazo.</p>
        </field>
    </record>
</odoo>
