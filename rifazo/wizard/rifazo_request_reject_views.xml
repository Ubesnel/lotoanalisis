<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rifazo_request_reject_form" model="ir.ui.view">
        <field name="name">rifazo.request.reject.form</field>
        <field name="model">rifazo.request.reject</field>
        <field name="arch" type="xml">
            <form>
                <p>Los números vuelven a quedar disponibles para la venta.</p>
                <group>
                    <field name="request_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Ej: No encontramos la transferencia en la cuenta"/>
                </group>
                <footer>
                    <button name="action_reject" string="Rechazar" type="object" class="btn-danger"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
