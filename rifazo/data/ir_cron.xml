<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Libera los números de las reservas que no subieron comprobante a tiempo. -->
    <record id="ir_cron_rifazo_expire_reservations" model="ir.cron">
        <field name="name">Rifazo: vencer reservas sin comprobante</field>
        <field name="model_id" ref="model_rifazo_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_reservations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
