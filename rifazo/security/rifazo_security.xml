<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rifazo" model="ir.module.category">
        <field name="name">Rifazo</field>
        <field name="sequence">60</field>
    </record>

    <!-- Verificador: revisa comprobantes, confirma y rechaza solicitudes. -->
    <record id="group_rifazo_user" model="res.groups">
        <field name="name">Verificador</field>
        <field name="category_id" ref="module_category_rifazo"/>
    </record>

    <!-- Administrador: además crea, abre, cierra y sortea rifas. -->
    <record id="group_rifazo_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_rifazo"/>
        <field name="implied_ids" eval="[(4, ref('group_rifazo_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
